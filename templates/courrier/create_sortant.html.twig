{% extends 'base.html.twig' %}

{% block title %}Nouveau courrier sortant - Gestion de Courrier{% endblock %}

{% block body %}
<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay">
    <div class="text-center">
        <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <div class="mt-2 fw-bold">Traitement intelligent en cours...</div>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-box-arrow-right"></i> Nouveau Courrier Sortant
            </h1>
        </div>
        <div class="col-auto">
            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" name="type" value="SORTANT">
                        
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="priorite" class="form-label">Priorité *</label>
                                    <select class="form-select" id="priorite" name="priorite" required>
                                        {% for prioriteValue in priorites %}
                                            <option value="{{ prioriteValue }}" {% if prioriteValue == 'NORMALE' %}selected{% endif %}>
                                                {{ prioriteValue }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="dateCourrier" class="form-label">Date du courrier *</label>
                                    <input type="date" class="form-control" id="dateCourrier" name="dateCourrier" value="{{ 'now'|date('Y-m-d') }}" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="numeroReference" class="form-label">N° Référence (Attribué après enregistrement)</label>
                                    <input type="text" class="form-control" id="numeroReference" placeholder="Généré automatiquement" readonly title="Le numéro sera généré au format : XXX/MEF/SG/DGI/{{ userService.sigle ?? userService.id }}">
                                </div>
                            </div>
                        </div>

                        <hr>
                        <h5>Expéditeur</h5>
                        <div class="alert alert-info">
                            <i class="bi bi-lock-fill"></i>
                            Pour un courrier sortant, l'expéditeur est votre service : <strong>{{ userService.nom }}</strong>
                        </div>
                        <input type="hidden" name="typeExpediteur" value="SERVICE">
                        <input type="hidden" name="serviceExpediteurId" value="{{ userService.id }}">

                        <hr>
                        <h5>Destinataire</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="typeDestinataire" class="form-label">Type de destinataire *</label>
                                    <select class="form-select" id="typeDestinataire" name="typeDestinataire" required>
                                        <option value="">-- Sélectionnez --</option>
                                        <option value="SERVICE">Service interne</option>
                                        <option value="PERSONNE_EXTERNE">Personne externe</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                        <div class="mb-3" id="serviceDestinataireGroup" style="display:none;">
                                    <label for="serviceDestinataireId" class="form-label">Service destinataire *</label>
                                    <select class="form-select" id="serviceDestinataireId" name="serviceDestinataireId">
                                        <option value="">-- Sélectionnez --</option>
                                        {% for service in services %}
                                            {% if service.id != userService.id %}
                                                <option value="{{ service.id }}">{{ service.nom }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="mb-3" id="personneDestinataireGroup" style="display:none;">
                                    <label for="personneExterneDestinataireId" class="form-label">Personne externe destinataire *</label>
                                    <select class="form-select" id="personneExterneDestinataireId" name="personneExterneDestinataireId">
                                        <option value="">-- Sélectionnez --</option>
                                        {% for personne in personnesExternes %}
                                            <option value="{{ personne.id }}">{{ personne.nomOuRaisonSociale }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>


                        <hr>
                        <div class="mb-3">
                            <label for="objet" class="form-label">Objet *</label>
                            <input type="text" class="form-control" id="objet" name="objet" required maxlength="500">
                        </div>

                        <div class="mb-3">
                            <label for="contenu" class="form-label">Contenu</label>
                            <textarea class="form-control" id="contenu" name="contenu" rows="10"></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-start mt-4">
                            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">Annuler</a>
                            <div class="d-flex flex-column align-items-end gap-2">
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-smart" id="btnSmartAI" title="L'IA peut vous aider à rédiger le contenu.">
                                        <i class="bi bi-robot"></i> Aide à la rédaction (IA)
                                    </button>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save"></i> Enregistrer le courrier
                                    </button>
                                </div>
                                <small class="text-muted"><i class="bi bi-info-circle"></i> Le texte généré par l'IA dans le contenu peut être modifié librement avant l'enregistrement.</small>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const typeDestSelect = document.getElementById('typeDestinataire');
        const serviceDestGroup = document.getElementById('serviceDestinataireGroup');
        const personneDestGroup = document.getElementById('personneDestinataireGroup');
        const serviceDestSelect = document.getElementById('serviceDestinataireId');
        const personneDestSelect = document.getElementById('personneExterneDestinataireId');
        const loadingOverlay = document.getElementById('loadingOverlay');

        let serviceSelectInstance = null;
        let personneSelectInstance = null;

        function initTomSelects() {
             // Init Service Select
             if (!serviceSelectInstance) {
                serviceSelectInstance = new TomSelect('#serviceDestinataireId', {
                    create: false,
                    sortField: {field: 'text', direction: 'asc'},
                    placeholder: 'Rechercher un service...',
                    plugins: ['clear_button'],
                     onChange: function(value) {
                         // Trigger native change event for listeners
                         const event = new Event('change');
                         document.getElementById('serviceDestinataireId').dispatchEvent(event);
                     }
                });
             }

             // Init Personne Select
             if (!personneSelectInstance) {
                personneSelectInstance = new TomSelect('#personneExterneDestinataireId', {
                    create: false,
                    sortField: {field: 'text', direction: 'asc'},
                    placeholder: 'Rechercher une personne...',
                    plugins: ['clear_button'],
                     onChange: function(value) {
                         // Trigger native change event for listeners
                         const event = new Event('change');
                         document.getElementById('personneExterneDestinataireId').dispatchEvent(event);
                     }
                });
             }
        }

        function syncDestinataireFields() {
            if (typeDestSelect.value === 'SERVICE') {
                serviceDestGroup.style.display = 'block';
                personneDestGroup.style.display = 'none';
                serviceDestSelect.required = true;
                personneDestSelect.required = false;
                
                // Clear validation state on hidden fields if possible
                if(personneSelectInstance) personneSelectInstance.clear();
                
            } else if (typeDestSelect.value === 'PERSONNE_EXTERNE') {
                serviceDestGroup.style.display = 'none';
                personneDestGroup.style.display = 'block';
                serviceDestSelect.required = false;
                personneDestSelect.required = true;
                
                if(serviceSelectInstance) serviceSelectInstance.clear();

            } else {
                serviceDestGroup.style.display = 'none';
                personneDestGroup.style.display = 'none';
            }
        }

        typeDestSelect.addEventListener('change', syncDestinataireFields);

        // Init TomSelects immediately but they work best when visible. 
        // However, TomSelect replaces the element, so we can init them.
        initTomSelects();
        
        // Initial sync
        syncDestinataireFields();

        // AI Logic
        document.getElementById('btnSmartAI')?.addEventListener('click', async () => {
            const objet = document.getElementById('objet').value;
            if (!objet) { showNotification("Saisissez un objet d'abord.", 'info'); return; }
            
            const rSelect = typeDestSelect.value === 'SERVICE' ? serviceDestSelect : personneDestSelect;
            // Get text from TomSelect if initialized, or fallback
            // TomSelect syncs back to original select, but retrieving text might need checking options
            let receiverName = "Destinataire";
            if (rSelect.selectedIndex !== -1) {
                 receiverName = rSelect.options[rSelect.selectedIndex].text;
            }
            
            const params = {
                senderService: "{{ userService.nom }}",
                receiverService: receiverName,
                letterNumber: "N/A",
                importance: document.getElementById('priorite').value || "HAUTE",
                prompt: objet
            };

            loadingOverlay.style.display = 'flex';
            try {
                const res = await fetch('{{ path('smart_generate_content') }}', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify(params) 
                });
                if (!res.ok) throw new Error("Erreur AI");
                const result = await res.json();
                if (result.subject) document.getElementById('objet').value = result.subject;
                if (result.body) document.getElementById('contenu').value = result.body;
                showNotification("Rédigé avec succès !", 'success');
            } catch (err) { showNotification(err.message, 'error'); } 
            finally { loadingOverlay.style.display = 'none'; }
        });


        // Validation Expéditeur != Destinataire
        const form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
            const typeDest = typeDestSelect.value;
            const userServiceId = "{{ userService.id }}";
            
            if (typeDest === 'SERVICE') {
                const serviceDestId = serviceDestSelect.value;
                if (serviceDestId === userServiceId) {
                    e.preventDefault();
                    showNotification("Erreur : Un courrier sortant ne peut pas être adressé à votre propre service.", 'error');
                    return false;
                }
            }
        });
    });
</script>
{% endblock %}
