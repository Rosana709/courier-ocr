{% extends 'base.html.twig' %}

{% block title %}Nouvel enregistrement courrier sortant - Gestion de Courrier{% endblock %}

{% block body %}
<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay">
    <div class="text-center">
        <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <div class="mt-2 fw-bold" id="loadingText">Traitement intelligent en cours...</div>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-box-arrow-right"></i> Nouvel Enregistrement Courrier Sortant
            </h1>
        </div>
        <div class="col-auto">
            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Smart Dashboard OCR -->
            <div id="smartDashboard" class="smart-card">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-stars smart-gradient-text fs-4 me-2"></i>
                    <h5 class="mb-0 smart-gradient-text">Assistant de saisie</h5>
                </div>
                <div>
                    <p class="small text-muted mb-3">Pour enregistrer un <strong>ancien courrier</strong>, importez le document pour remplir automatiquement les champs.</p>
                    <input type="file" id="smartOcrFileInput" style="display: none;" accept="image/*,application/pdf">
                    <button type="button" class="btn btn-smart" id="btnSmartOCR">
                        <i class="bi bi-camera"></i> Lire un document ancien (automatique)
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-pencil-square text-primary"></i> Nouveau courrier</h5>
                    <p class="small text-muted mb-0">S'il s'agit d'un nouveau courrier à rédiger, veuillez remplir ce formulaire.</p>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" name="type" value="SORTANT">
                        
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="priorite" class="form-label fw-bold">Priorité <span class="text-danger">*</span></label>
                                    <select class="form-select" id="priorite" name="priorite" required data-bs-toggle="tooltip" title="Niveau d'urgence du traitement">
                                        {% for prioriteValue in priorites %}
                                            <option value="{{ prioriteValue }}" {% if prioriteValue == 'NORMALE' %}selected{% endif %}>
                                                {{ prioriteValue }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="dateCourrier" class="form-label fw-bold">Date du courrier <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="dateCourrier" name="dateCourrier" value="{{ 'now'|date('Y-m-d') }}" required data-bs-toggle="tooltip" title="Date portée sur le document physique">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="numeroReference" class="form-label fw-bold">N° Référence</label>
                                    <input type="text" 
                                           class="form-control bg-light" 
                                           id="numeroReference" 
                                           name="numeroReference"
                                           readonly
                                           data-bs-toggle="tooltip"
                                           title="Le numéro sera généré automatiquement lors de l'enregistrement.">
                                </div>
                            </div>
                        </div>

                        <hr>
                        <h5>Expéditeur</h5>
                        <div class="alert alert-info">
                            <i class="bi bi-lock-fill"></i>
                            Pour un courrier sortant, l'expéditeur est votre service : <strong>{{ userService.nom }}</strong>
                        </div>
                        <input type="hidden" name="typeExpediteur" value="SERVICE">
                        <input type="hidden" name="serviceExpediteurId" value="{{ userService.id }}">

                        <hr>
                        <h5>Destinataire</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="typeDestinataire" class="form-label fw-bold">Type de destinataire <span class="text-danger">*</span></label>
                                    <select class="form-select" id="typeDestinataire" name="typeDestinataire" required data-bs-toggle="tooltip" title="Choisissez si le destinataire est interne ou externe">
                                        <option value="">-- Sélectionnez --</option>
                                        <option value="SERVICE">Service interne</option>
                                        <option value="PERSONNE_EXTERNE">Personne externe</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                        <div class="mb-3" id="serviceDestinataireGroup" style="display:none;">
                                    <label for="serviceDestinataireId" class="form-label">Service destinataire *</label>
                                    <select class="form-select" id="serviceDestinataireId" name="serviceDestinataireId">
                                        <option value="">-- Sélectionnez --</option>
                                        {% for service in services %}
                                            {% if service.id != userService.id %}
                                                <option value="{{ service.id }}">{{ service.nom }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="mb-3" id="personneDestinataireGroup" style="display:none;">
                                    <label for="personneExterneDestinataireId" class="form-label">Personne externe destinataire *</label>
                                    <select class="form-select" id="personneExterneDestinataireId" name="personneExterneDestinataireId">
                                        <option value="">-- Sélectionnez --</option>
                                        {% for personne in personnesExternes %}
                                            <option value="{{ personne.id }}">{{ personne.nomOuRaisonSociale }}</option>
                                        {% endfor %}
                                        <option value="NEW_EXTERNAL">Autre</option>
                                    </select>
                                </div>
                                <div id="nomNouvellePersonneGroup" style="display:none;" class="p-3 bg-light border rounded mb-3">
                                    <h6 class="text-primary mb-3"><i class="bi bi-person-plus"></i> Ajouter une personne externe</h6>
                                    <div class="mb-3">
                                        <label for="nomNouvellePersonne" class="form-label">Nom / Raison Sociale *</label>
                                        <input type="text" class="form-control" id="nomNouvellePersonne" name="nomNouvellePersonne" placeholder="Entrez le nom complet">
                                    </div>
                                    <div class="mb-0">
                                        <label for="typeNouvellePersonne" class="form-label">Type de personne *</label>
                                        <select class="form-select" id="typeNouvellePersonne" name="typeNouvellePersonne">
                                            <option value="ORGANISME">Organisme</option>
                                            <option value="ADMINISTRATION">Administration</option>
                                            <option value="ENTREPRISE">Entreprise</option>
                                            <option value="CONTRIBUABLE">Particulier / Contribuable</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <hr>
                        <div class="mb-3">
                            <label for="objet" class="form-label fw-bold">Objet <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="objet" name="objet" required maxlength="500" placeholder="Sujet principal du courrier" data-bs-toggle="tooltip" title="Saisissez un titre clair et explicite">
                        </div>

                        <div class="mb-3">
                            <label for="contenu" class="form-label">Contenu</label>
                            <textarea class="form-control" id="contenu" name="contenu" rows="10"></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-start mt-4">
                            <a href="{{ path('courrier_index') }}" class="btn btn-secondary" data-confirm="Êtes-vous sûr de vouloir annuler la saisie ? Toutes les données non enregistrées seront perdues.">Annuler</a>
                            <div class="d-flex flex-column align-items-end gap-2">
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-smart" id="btnSmartAI" title="L'IA peut vous aider à rédiger le contenu.">
                                        <i class="bi bi-robot"></i> Aide à la rédaction (IA)
                                    </button>
                                    <button type="submit" class="btn btn-primary" id="btnSubmitCourrier">
                                        <span class="submit-spinner spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        <i class="bi bi-save btn-icon"></i> <span class="btn-text">Enregistrer le courrier</span>
                                    </button>
                                </div>
                                <small class="text-muted"><i class="bi bi-info-circle"></i> Le texte généré par l'IA dans le contenu peut être modifié librement avant l'enregistrement.</small>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const typeDestSelect = document.getElementById('typeDestinataire');
        const serviceDestGroup = document.getElementById('serviceDestinataireGroup');
        const personneDestGroup = document.getElementById('personneDestinataireGroup');
        const serviceDestSelect = document.getElementById('serviceDestinataireId');
        const personneDestSelect = document.getElementById('personneExterneDestinataireId');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const loadingText = document.getElementById('loadingText');

        const nomNouvellePersonneGroup = document.getElementById('nomNouvellePersonneGroup');
        const nomNouvellePersonneInput = document.getElementById('nomNouvellePersonne');

        let serviceSelectInstance = null;
        let personneSelectInstance = null;

        function initTomSelects() {
             // Init Service Select
             if (!serviceSelectInstance) {
                serviceSelectInstance = new TomSelect('#serviceDestinataireId', {
                    create: false,
                    sortField: {field: 'text', direction: 'asc'},
                    placeholder: 'Rechercher un service...',
                    plugins: ['clear_button'],
                     onChange: function(value) {
                         // Trigger native change event for listeners
                         const event = new Event('change');
                         document.getElementById('serviceDestinataireId').dispatchEvent(event);
                     }
                });
             }

             // Init Personne Select
             if (!personneSelectInstance) {
                personneSelectInstance = new TomSelect('#personneExterneDestinataireId', {
                    create: false,
                    sortField: {field: 'text', direction: 'asc'},
                    placeholder: 'Rechercher une personne...',
                    plugins: ['clear_button'],
                     onChange: function(value) {
                         // Trigger native change event for listeners
                         syncNouvellePersonne();
                         const event = new Event('change');
                         document.getElementById('personneExterneDestinataireId').dispatchEvent(event);
                     }
                });
             }
        }

        function syncDestinataireFields() {
            if (typeDestSelect.value === 'SERVICE') {
                serviceDestGroup.style.display = 'block';
                personneDestGroup.style.display = 'none';
                nomNouvellePersonneGroup.style.display = 'none';
                serviceDestSelect.required = true;
                personneDestSelect.required = false;
                nomNouvellePersonneInput.required = false;
                
                // Clear validation state on hidden fields if possible
                // if(personneSelectInstance) personneSelectInstance.clear();
                
            } else if (typeDestSelect.value === 'PERSONNE_EXTERNE') {
                serviceDestGroup.style.display = 'none';
                personneDestGroup.style.display = 'block';
                serviceDestSelect.required = false;
                personneDestSelect.required = true;
                
                // if(serviceSelectInstance) serviceSelectInstance.clear();
                syncNouvellePersonne();

            } else {
                serviceDestGroup.style.display = 'none';
                personneDestGroup.style.display = 'none';
                nomNouvellePersonneGroup.style.display = 'none';
            }
        }

        function syncNouvellePersonne() {
            if (personneDestSelect.value === 'NEW_EXTERNAL') {
                nomNouvellePersonneGroup.style.display = 'block';
                nomNouvellePersonneInput.required = true;
            } else {
                nomNouvellePersonneGroup.style.display = 'none';
                nomNouvellePersonneInput.required = false;
            }
        }

        typeDestSelect.addEventListener('change', syncDestinataireFields);
        personneDestSelect.addEventListener('change', syncNouvellePersonne);

        // Init TomSelects immediately but they work best when visible. 
        initTomSelects();
        
        // Initial sync
        syncDestinataireFields();

        // OCR Logic
        const smartOcrFileInput = document.getElementById('smartOcrFileInput');
        document.getElementById('btnSmartOCR')?.addEventListener('click', () => smartOcrFileInput.click());
        
        smartOcrFileInput?.addEventListener('change', async (e) => {
            if (!e.target.files.length) return;
            const formData = new FormData();
            formData.append('file', e.target.files[0]);
            loadingText.innerText = "Analyse OCR en cours...";
            loadingOverlay.style.display = 'flex';
            try {
                const response = await fetch('{{ path('smart_extract') }}', { method: 'POST', body: formData });
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(errorData.message || errorData.error || "Erreur lors de l'analyse OCR");
                }
                
                const result = await response.json();
                const data = result.data || {};

                // Vérification des doublons
                if (result.isDuplicate) {
                    showNotification("Erreur : Ce document est déjà enregistré (N° " + (data.letterNumber || "inconnu") + ").\nL'analyse est annulée.", 'error');
                    loadingOverlay.style.display = 'none';
                    smartOcrFileInput.value = '';
                    return;
                }

                // Pour un courrier SORTANT, on vérifie si l'expéditeur du doc est bien nous
                if (data.senderService) {
                    const normalize = (str) => {
                        return str.toLowerCase()
                            .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                            .replace(/s\b/g, "")
                            .replace(/\([^)]*\)/g, "")
                            .replace(/[^a-z0-9]/g, "")
                            .trim();
                    };

                    const sName = normalize(data.senderService);
                    const userServiceName = normalize("{{ userService.nom }}");
                    
                    if (!sName.includes(userServiceName) && !userServiceName.includes(sName)) {
                        // On prévient juste, on ne bloque pas forcément car le nom peut différer un peu
                        console.warn("L'expéditeur détecté semble différent du service actuel.");
                    }
                }
                
                if (data.subject) document.getElementById('objet').value = data.subject;
                if (data.body) document.getElementById('contenu').value = data.body;
                if (data.letterNumber) document.getElementById('numeroReference').value = data.letterNumber;
                if (data.date) {
                    const dVal = data.date.match(/\d{4}-\d{2}-\d{2}/);
                    if (dVal) document.getElementById('dateCourrier').value = dVal[0];
                }
                
                // Tentative de mapping destinataire (receiverService dans le JSON OCR)
                if (data.receiverService) {
                    const rName = data.receiverService.toLowerCase();
                    let found = false;

                    // 1. Chercher dans les services
                    const sOpts = document.getElementById('serviceDestinataireId').options;
                    for (let i = 0; i < sOpts.length; i++) {
                        const optText = sOpts[i].text.toLowerCase();
                        if (optText.includes(rName) || rName.includes(optText)) {
                            typeDestSelect.value = 'SERVICE';
                            syncDestinataireFields();
                            if (serviceSelectInstance) serviceSelectInstance.setValue(sOpts[i].value);
                            found = true;
                            break;
                        }
                    }

                    // 2. Chercher dans les personnes externes
                    if (!found) {
                        const pOpts = document.getElementById('personneExterneDestinataireId').options;
                        for (let i = 0; i < pOpts.length; i++) {
                            const optText = pOpts[i].text.toLowerCase();
                            if (pOpts[i].value !== 'NEW_EXTERNAL' && (optText.includes(rName) || rName.includes(optText))) {
                                typeDestSelect.value = 'PERSONNE_EXTERNE';
                                syncDestinataireFields();
                                if (personneSelectInstance) personneSelectInstance.setValue(pOpts[i].value);
                                found = true;
                                break;
                            }
                        }
                    }

                    // 3. Sinon, marquer comme nouveau
                    if (!found) {
                        typeDestSelect.value = 'PERSONNE_EXTERNE';
                        syncDestinataireFields();
                        if (personneSelectInstance) personneSelectInstance.setValue('NEW_EXTERNAL');
                        syncNouvellePersonne();
                        nomNouvellePersonneInput.value = data.receiverService;
                    }
                }
                
                showNotification("Analyse terminée ! Les champs ont été remplis.", 'success');
            } catch (err) { showNotification(err.message, 'error'); } 
            finally { loadingOverlay.style.display = 'none'; smartOcrFileInput.value = ''; }
        });

        // AI Logic
        document.getElementById('btnSmartAI')?.addEventListener('click', async () => {
            const objet = document.getElementById('objet').value;
            if (!objet) { showNotification("Saisissez un objet d'abord.", 'info'); return; }
            
            const rSelect = typeDestSelect.value === 'SERVICE' ? serviceDestSelect : personneDestSelect;
            let receiverName = "Destinataire";
            if (rSelect.selectedIndex !== -1) {
                 receiverName = rSelect.options[rSelect.selectedIndex].text;
            }
            
            const params = {
                senderService: "{{ userService.nom }}",
                receiverService: receiverName,
                letterNumber: document.getElementById('numeroReference').value || "N/A",
                importance: document.getElementById('priorite').value || "HAUTE",
                prompt: objet
            };

            loadingText.innerText = "Traitement intelligent en cours...";
            loadingOverlay.style.display = 'flex';
            try {
                const res = await fetch('{{ path('smart_generate_content') }}', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify(params) 
                });
                if (!res.ok) throw new Error("Erreur AI");
                const result = await res.json();
                if (result.subject) document.getElementById('objet').value = result.subject;
                if (result.body) document.getElementById('contenu').value = result.body;
                showNotification("Rédigé avec succès !", 'success');
            } catch (err) { showNotification(err.message, 'error'); } 
            finally { loadingOverlay.style.display = 'none'; }
        });


        // Initialiser les tooltips Bootstrap
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Logic de confirmation avec numéro de référence en temps réel
        const form = document.querySelector('form');
        const btnSubmit = document.getElementById('btnSubmitCourrier');
        
        btnSubmit.addEventListener('click', async function(e) {
            e.preventDefault();

            // Validation : Pas au même service
            const typeDest = typeDestSelect.value;
            const userServiceId = "{{ userService.id }}";
            
            if (typeDest === 'SERVICE') {
                const serviceDestId = serviceDestSelect.value;
                if (serviceDestId === userServiceId) {
                    showNotification("Erreur : Un courrier sortant ne peut pas être adressé à votre propre service.", 'error');
                    return false;
                }
            }

            // Vérification des champs obligatoires natifs
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            
            let refToDisplay = "";

            // Interroger l'API pour savoir quel sera le prochain numéro
            try {
                const response = await fetch('{{ path('smart_next_reference') }}');
                const result = await response.json();
                if (result.nextReference) {
                    refToDisplay = result.nextReference;
                    // On remplit IMMÉDIATEMENT le champ dans le formulaire
                    document.getElementById('numeroReference').value = refToDisplay;
                }
            } catch (err) {
                console.error("Erreur récup ref:", err);
            }

            const message = `Voulez-vous vraiment enregistrer ce courrier sortant ?<br><br>Le numéro de référence sera : ${refToDisplay || 'En cours...'}<br><br>Cette action est irréversible une fois validée.`;
            
            window.showStyledModal(message, false, () => {
                // Animation du bouton
                const spinner = btnSubmit.querySelector('.submit-spinner');
                const icon = btnSubmit.querySelector('.btn-icon');
                const text = btnSubmit.querySelector('.btn-text');
                
                btnSubmit.disabled = true;
                if (spinner) spinner.classList.remove('d-none');
                if (icon) icon.classList.add('d-none');
                if (text) text.innerText = "Enregistrement...";
                
                // Soumettre le formulaire
                form.submit();
            });
        });
    });
</script>
{% endblock %}

