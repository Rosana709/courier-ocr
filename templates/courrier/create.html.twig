{% extends 'base.html.twig' %}

{% block title %}Nouveau courrier - Gestion de Courrier{% endblock %}

{% block body %}
<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-envelope-plus"></i> Nouveau Courrier
            </h1>
        </div>
        <div class="col-auto">
            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form method="post">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="type" class="form-label">Type de courrier *</label>
                            <select class="form-select" id="type" name="type" required>
                                <option value="">-- Sélectionnez --</option>
                                {% for typeValue in types %}
                                    <option value="{{ typeValue }}">
                                        {% if typeValue == 'ENTRANT' %}Entrant{% else %}Sortant{% endif %}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Numéro de référence (pour courriers entrants uniquement) #}
                        <div class="mb-3" id="numeroReferenceField" style="display: none;">
                            <label for="numeroReference" class="form-label">
                                Numéro de référence de l'expéditeur
                                <small class="text-muted">(obligatoire pour un courrier entrant)</small>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="numeroReference"
                                   name="numeroReference"
                                   maxlength="100"
                                   placeholder="Ex: 123/2025/EXP">
                            <div class="form-text">
                                Le numéro de référence fourni par l'expéditeur (courrier sortant d'origine)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="priorite" class="form-label">Priorité *</label>
                            <select class="form-select" id="priorite" name="priorite" required>
                                {% for prioriteValue in priorites %}
                                    <option value="{{ prioriteValue }}" {% if prioriteValue == 'NORMALE' %}selected{% endif %}>
                                        {{ prioriteValue }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="dateCourrier" class="form-label">Date du courrier *</label>
                            <input type="date" class="form-control" id="dateCourrier" name="dateCourrier" value="{{ 'now'|date('Y-m-d') }}" required>
                        </div>
                    </div>
                </div>

                <hr>

                <h5>Expéditeur</h5>
                <input type="hidden" id="hiddenTypeExpediteur" name="typeExpediteur" value="SERVICE">
                <input type="hidden" id="hiddenServiceExpediteurId" name="serviceExpediteurId" value="{{ userService.id }}">
                <input type="hidden" id="hiddenPersonneExpediteurId" name="personneExterneExpediteurId" value="">

                <div class="mb-3" id="expediteurLockedInfo" style="display:none;">
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-lock-fill"></i>
                        Pour un courrier sortant, l'expéditeur est votre service : <strong>{{ userService.nom }}</strong>
                    </div>
                </div>

                <div id="expediteurFields">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="typeExpediteur" class="form-label">Type d'expéditeur *</label>
                                <select class="form-select" id="typeExpediteur" name="typeExpediteur_select">
                                    <option value="">-- Sélectionnez --</option>
                                    <option value="SERVICE">Service interne</option>
                                    <option value="PERSONNE_EXTERNE">Personne externe</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3" id="serviceExpediteurGroup" style="display:none;">
                                <label for="serviceExpediteurId" class="form-label">Service expéditeur *</label>
                                <select class="form-select" id="serviceExpediteurId" name="serviceExpediteurId_select">
                                    <option value="">-- Sélectionnez --</option>
                                    {% for service in services %}
                                        <option value="{{ service.id }}">{{ service.nom }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3" id="personneExterneExpediteurGroup" style="display:none;">
                                <label for="personneExterneExpediteurId" class="form-label">Personne externe expéditeur *</label>
                                <select class="form-select" id="personneExterneExpediteurId" name="personneExterneExpediteurId_select">
                                    <option value="">-- Sélectionnez --</option>
                                    {% for personne in personnesExternes %}
                                        <option value="{{ personne.id }}">{{ personne.nomOuRaisonSociale }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <hr>

                <h5>Destinataire</h5>
                <input type="hidden" id="hiddenTypeDestinataire" name="typeDestinataire" value="">
                <input type="hidden" id="hiddenServiceDestinataireId" name="serviceDestinataireId" value="">
                <input type="hidden" id="hiddenPersonneDestinataireId" name="personneExterneDestinataireId" value="">

                <div class="mb-3" id="destinataireLockInfo" style="display:none;">
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-lock-fill"></i>
                        Pour un courrier entrant, le destinataire est votre service : <strong>{{ userService.nom }}</strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="typeDestinataire" class="form-label">Type de destinataire *</label>
                            <select class="form-select" id="typeDestinataire" name="typeDestinataire" required>
                                <option value="">-- Sélectionnez --</option>
                                <option value="SERVICE">Service interne</option>
                                <option value="PERSONNE_EXTERNE">Personne externe</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3" id="serviceDestinataireGroup" style="display:none;">
                            <label for="serviceDestinataireId" class="form-label">Service destinataire *</label>
                            <select class="form-select" id="serviceDestinataireId" name="serviceDestinataireId">
                                <option value="">-- Sélectionnez --</option>
                                {% for service in services %}
                                    <option value="{{ service.id }}">{{ service.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3" id="personneExterneDestinataireGroup" style="display:none;">
                            <label for="personneExterneDestinataireId" class="form-label">Personne externe destinataire *</label>
                            <select class="form-select" id="personneExterneDestinataireId" name="personneExterneDestinataireId">
                                <option value="">-- Sélectionnez --</option>
                                {% for personne in personnesExternes %}
                                    <option value="{{ personne.id }}">{{ personne.nomOuRaisonSociale }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="destinatairesCopieIds" class="form-label">Services en copie</label>
                    <select class="form-select" id="destinatairesCopieIds" name="destinatairesCopieIds[]" multiple>
                        {% for service in services %}
                            <option value="{{ service.id }}">{{ service.nom }}</option>
                        {% endfor %}
                    </select>
                    <small class="form-text text-muted">Maintenez Ctrl pour sélectionner plusieurs services</small>
                </div>

                <hr>

                <div class="mb-3">
                    <label for="objet" class="form-label">Objet *</label>
                    <input type="text" class="form-control" id="objet" name="objet" required maxlength="500">
                </div>

                <div class="mb-3">
                    <label for="contenu" class="form-label">Contenu</label>
                    <textarea class="form-control" id="contenu" name="contenu" rows="5"></textarea>
                </div>

                <div class="mb-3">
                    <label for="notes" class="form-label">Notes</label>
                    <textarea class="form-control" id="notes" name="notes" rows="3"></textarea>
                </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-info-circle"></i>
                        Informations
                    </h6>
                    <ul class="list-unstyled small">
                        <li><strong>Courrier Entrant :</strong> Courrier reçu de l'extérieur ou d'un autre service</li>
                        <li><strong>Courrier Sortant :</strong> Courrier envoyé à l'extérieur ou à un autre service</li>
                        <li><strong>Numéro de référence :</strong> Généré automatiquement au format N° XXX – année/DGI/SERVICE</li>
                        <li><strong>Priorités :</strong>
                            <ul class="mb-0">
                                <li>URGENTE : Traitement immédiat requis</li>
                                <li>NORMALE : Traitement standard</li>
                                <li>BASSE : Non urgent</li>
                            </ul>
                        </li>
                    </ul>

                    <h6 class="card-title mt-3">
                        <i class="bi bi-lightbulb"></i>
                        Conseils
                    </h6>
                    <ul class="list-unstyled small">
                        <li>• Vérifiez le type de courrier (Entrant/Sortant)</li>
                        <li>• <strong>Courrier ENTRANT :</strong> Saisissez le numéro de référence de l'expéditeur si disponible. Un numéro d'arrivée sera généré automatiquement : N° XXX-2025/DG/SERVICE</li>
                        <li>• <strong>Courrier SORTANT :</strong> Le numéro de référence sera généré automatiquement au format DGI</li>
                        <li>• Sélectionnez d'abord le type de destinataire</li>
                        <li>• Utilisez "Services en copie" pour informer d'autres services</li>
                        <li>• Rédigez un objet clair et précis</li>
                        <li>• Les pièces jointes peuvent être ajoutées après la création</li>
                        <li>• Une notification sera envoyée automatiquement au destinataire</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const typeSelect = document.getElementById('type');
        const numeroRefField = document.getElementById('numeroReferenceField');
        const numeroRefInput = document.getElementById('numeroReference');

        const typeDestinataire = document.getElementById('typeDestinataire');
        const serviceDestinataireGroup = document.getElementById('serviceDestinataireGroup');
        const personneExterneDestinataireGroup = document.getElementById('personneExterneDestinataireGroup');
        const serviceDestinataireSelect = document.getElementById('serviceDestinataireId');
        const destinataireLockInfo = document.getElementById('destinataireLockInfo');
        const hiddenTypeDest = document.getElementById('hiddenTypeDestinataire');
        const hiddenServiceDest = document.getElementById('hiddenServiceDestinataireId');
        const hiddenPersonneDest = document.getElementById('hiddenPersonneDestinataireId');

        const typeExpSelect = document.getElementById('typeExpediteur');
        const serviceExpGroup = document.getElementById('serviceExpediteurGroup');
        const personneExpGroup = document.getElementById('personneExterneExpediteurGroup');
        const serviceExpSelect = document.getElementById('serviceExpediteurId');
        const personneExpSelect = document.getElementById('personneExterneExpediteurId');
        const hiddenTypeExp = document.getElementById('hiddenTypeExpediteur');
        const hiddenServiceExp = document.getElementById('hiddenServiceExpediteurId');
        const hiddenPersonneExp = document.getElementById('hiddenPersonneExpediteurId');
        const expediteurFields = document.getElementById('expediteurFields');
        const expediteurLockedInfo = document.getElementById('expediteurLockedInfo');

        const userServiceId = "{{ userService.id }}";

        function toggleNumeroReference() {
            if (typeSelect && numeroRefField) {
                if (typeSelect.value === 'ENTRANT') {
                    numeroRefField.style.display = 'block';
                    numeroRefInput.required = true;
                } else {
                    numeroRefField.style.display = 'none';
                    numeroRefInput.required = false;
                }
            }
        }

        if (typeSelect) {
            typeSelect.addEventListener('change', toggleNumeroReference);
            toggleNumeroReference();
        }

        function applyDestinataireLock() {
            const type = typeSelect.value;

            if (type === 'ENTRANT') {
                typeDestinataire.value = 'SERVICE';
                hiddenTypeDest.value = 'SERVICE';
                destinataireLockInfo.style.display = 'block';

                serviceDestinataireGroup.style.display = 'block';
                personneExterneDestinataireGroup.style.display = 'none';
                serviceDestinataireSelect.required = true;
                document.getElementById('personneExterneDestinataireId').required = false;

                serviceDestinataireSelect.value = userServiceId;
                serviceDestinataireSelect.setAttribute('disabled', 'disabled');
                hiddenServiceDest.value = userServiceId;
                hiddenPersonneDest.value = '';
                typeDestinataire.setAttribute('disabled', 'disabled');
            } else {
                typeDestinataire.removeAttribute('disabled');
                destinataireLockInfo.style.display = 'none';
                serviceDestinataireGroup.style.display = 'none';
                personneExterneDestinataireGroup.style.display = 'none';
                serviceDestinataireSelect.required = false;
                document.getElementById('personneExterneDestinataireId').required = false;
                serviceDestinataireSelect.removeAttribute('disabled');
                serviceDestinataireSelect.value = '';
                hiddenTypeDest.value = typeDestinataire.value;
                hiddenServiceDest.value = '';
                hiddenPersonneDest.value = '';
            }
        }

        function syncDestinataireFields() {
            hiddenTypeDest.value = typeDestinataire.value || '';
            if (typeDestinataire.value === 'SERVICE') {
                hiddenServiceDest.value = serviceDestinataireSelect.value || '';
                hiddenPersonneDest.value = '';
            } else if (typeDestinataire.value === 'PERSONNE_EXTERNE') {
                hiddenServiceDest.value = '';
                hiddenPersonneDest.value = document.getElementById('personneExterneDestinataireId').value || '';
            } else {
                hiddenServiceDest.value = '';
                hiddenPersonneDest.value = '';
            }
        }

        function applyExpediteurLock() {
            const type = typeSelect.value;
            if (type === 'SORTANT') {
                // verrouillage expéditeur = service connecté
                expediteurLockedInfo.style.display = 'block';
                expediteurFields.style.display = 'none';

                typeExpSelect.value = 'SERVICE';
                serviceExpSelect.value = userServiceId;
                personneExpSelect.value = '';

                typeExpSelect.setAttribute('disabled', 'disabled');
                serviceExpSelect.setAttribute('disabled', 'disabled');
                personneExpSelect.setAttribute('disabled', 'disabled');

                hiddenTypeExp.value = 'SERVICE';
                hiddenServiceExp.value = userServiceId;
                hiddenPersonneExp.value = '';
            } else {
                expediteurLockedInfo.style.display = 'none';
                expediteurFields.style.display = 'block';

                typeExpSelect.removeAttribute('disabled');
                serviceExpSelect.removeAttribute('disabled');
                personneExpSelect.removeAttribute('disabled');

                typeExpSelect.value = '';
                serviceExpSelect.value = '';
                personneExpSelect.value = '';

                hiddenTypeExp.value = '';
                hiddenServiceExp.value = '';
                hiddenPersonneExp.value = '';
            }
        }

        function syncExpediteurFields() {
            hiddenTypeExp.value = typeExpSelect.value || '';
            if (typeExpSelect.value === 'SERVICE') {
                hiddenServiceExp.value = serviceExpSelect.value || '';
                hiddenPersonneExp.value = '';
            } else if (typeExpSelect.value === 'PERSONNE_EXTERNE') {
                hiddenServiceExp.value = '';
                hiddenPersonneExp.value = personneExpSelect.value || '';
            } else {
                hiddenServiceExp.value = '';
                hiddenPersonneExp.value = '';
            }

            if (typeExpSelect.value === 'SERVICE') {
                serviceExpGroup.style.display = 'block';
                personneExpGroup.style.display = 'none';
            } else if (typeExpSelect.value === 'PERSONNE_EXTERNE') {
                serviceExpGroup.style.display = 'none';
                personneExpGroup.style.display = 'block';
            } else {
                serviceExpGroup.style.display = 'none';
                personneExpGroup.style.display = 'none';
            }
        }

        typeDestinataire.addEventListener('change', function() {
            if (this.value === 'SERVICE') {
                serviceDestinataireGroup.style.display = 'block';
                personneExterneDestinataireGroup.style.display = 'none';
                serviceDestinataireSelect.required = true;
                document.getElementById('personneExterneDestinataireId').required = false;
                syncDestinataireFields();
            } else if (this.value === 'PERSONNE_EXTERNE') {
                serviceDestinataireGroup.style.display = 'none';
                personneExterneDestinataireGroup.style.display = 'block';
                serviceDestinataireSelect.required = false;
                document.getElementById('personneExterneDestinataireId').required = true;
                syncDestinataireFields();
            } else {
                serviceDestinataireGroup.style.display = 'none';
                personneExterneDestinataireGroup.style.display = 'none';
                serviceDestinataireSelect.required = false;
                document.getElementById('personneExterneDestinataireId').required = false;
                syncDestinataireFields();
            }
        });

        if (typeSelect) {
            typeSelect.addEventListener('change', function() {
                toggleNumeroReference();
                applyDestinataireLock();
                applyExpediteurLock();
            });
        }

        if (typeExpSelect) {
            typeExpSelect.addEventListener('change', syncExpediteurFields);
            serviceExpSelect.addEventListener('change', syncExpediteurFields);
            personneExpSelect.addEventListener('change', syncExpediteurFields);
        }

        if (typeDestinataire) {
            typeDestinataire.addEventListener('change', syncDestinataireFields);
            serviceDestinataireSelect.addEventListener('change', syncDestinataireFields);
            document.getElementById('personneExterneDestinataireId').addEventListener('change', syncDestinataireFields);
        }

        // Initial state
        toggleNumeroReference();
        applyDestinataireLock();
        applyExpediteurLock();
        syncExpediteurFields();
        syncDestinataireFields();
    });
</script>
{% endblock %}
