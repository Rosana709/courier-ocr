{% extends 'base.html.twig' %}

{% block title %}Nouveau courrier - Gestion de Courrier{% endblock %}

{% block body %}
<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay">
    <div class="text-center">
        <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <div class="mt-2 fw-bold">Traitement intelligent en cours...</div>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-envelope-plus"></i> Nouveau Courrier
            </h1>
        </div>
        <div class="col-auto">
            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Smart Dashboard -->
            <div id="smartDashboard" class="smart-card" style="display: none;">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-stars smart-gradient-text fs-4 me-2"></i>
                    <h5 class="mb-0 smart-gradient-text">Assistant Intelligent</h5>
                </div>
                
                <!-- OCR Section (For Incoming) -->
                <div id="smartOcrSection" style="display: none;">
                    <p class="small text-muted mb-3">Analysez un document PDF ou image pour pré-remplir automatiquement le formulaire.</p>
                    <input type="file" id="smartOcrFileInput" style="display: none;" accept="image/*,application/pdf">
                    <button type="button" class="btn btn-smart" id="btnSmartOCR">
                        <i class="bi bi-camera"></i> Analyser un document (OCR)
                    </button>
                </div>

                <!-- AI Writing Section (For Outgoing) -->
                <div id="smartAiSection" style="display: none;">
                    <p class="small text-muted mb-3">Utilisez l'IA pour rédiger le contenu formel basé sur l'objet de votre courrier.</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-smart" id="btnSmartAI">
                            <i class="bi bi-robot"></i> Rédiger via IA
                        </button>
                        <button type="button" class="btn btn-outline-danger" id="btnSmartPDF">
                            <i class="bi bi-file-earmark-pdf"></i> Exporter PDF
                        </button>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <form method="post">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="type" class="form-label">Type de courrier *</label>
                            <select class="form-select" id="type" name="type" required>
                                <option value="">-- Sélectionnez --</option>
                                {% for typeValue in types %}
                                    <option value="{{ typeValue }}">
                                        {% if typeValue == 'ENTRANT' %}Entrant{% else %}Sortant{% endif %}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Numéro de référence (pour courriers entrants uniquement) #}
                        <div class="mb-3" id="numeroReferenceField" style="display: none;">
                            <label for="numeroReference" class="form-label">
                                Numéro de référence de l'expéditeur
                                <small class="text-muted">(obligatoire pour un courrier entrant)</small>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="numeroReference"
                                   name="numeroReference"
                                   maxlength="100"
                                   placeholder="Ex: 123/2025/EXP">
                            <div class="form-text">
                                Le numéro de référence fourni par l'expéditeur (courrier sortant d'origine)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="priorite" class="form-label">Priorité *</label>
                            <select class="form-select" id="priorite" name="priorite" required>
                                {% for prioriteValue in priorites %}
                                    <option value="{{ prioriteValue }}" {% if prioriteValue == 'NORMALE' %}selected{% endif %}>
                                        {{ prioriteValue }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="dateCourrier" class="form-label">Date du courrier *</label>
                            <input type="date" class="form-control" id="dateCourrier" name="dateCourrier" value="{{ 'now'|date('Y-m-d') }}" required>
                        </div>
                    </div>
                </div>

                <hr>

                <h5>Expéditeur</h5>
                <input type="hidden" id="hiddenTypeExpediteur" name="typeExpediteur" value="SERVICE">
                <input type="hidden" id="hiddenServiceExpediteurId" name="serviceExpediteurId" value="{{ userService.id }}">
                <input type="hidden" id="hiddenPersonneExpediteurId" name="personneExterneExpediteurId" value="">

                <div class="mb-3" id="expediteurLockedInfo" style="display:none;">
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-lock-fill"></i>
                        Pour un courrier sortant, l'expéditeur est votre service : <strong>{{ userService.nom }}</strong>
                    </div>
                </div>

                <div id="expediteurFields">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="typeExpediteur" class="form-label">Type d'expéditeur *</label>
                                <select class="form-select" id="typeExpediteur" name="typeExpediteur_select">
                                    <option value="">-- Sélectionnez --</option>
                                    <option value="SERVICE">Service interne</option>
                                    <option value="PERSONNE_EXTERNE">Personne externe</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3" id="serviceExpediteurGroup" style="display:none;">
                                <label for="serviceExpediteurId" class="form-label">Service expéditeur *</label>
                                <select class="form-select" id="serviceExpediteurId" name="serviceExpediteurId_select">
                                    <option value="">-- Sélectionnez --</option>
                                    {% for service in services %}
                                        <option value="{{ service.id }}">{{ service.nom }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3" id="personneExterneExpediteurGroup" style="display:none;">
                                <label for="personneExterneExpediteurId" class="form-label">Personne externe expéditeur *</label>
                                <select class="form-select" id="personneExterneExpediteurId" name="personneExterneExpediteurId_select">
                                    <option value="">-- Sélectionnez --</option>
                                    {% for personne in personnesExternes %}
                                        <option value="{{ personne.id }}">{{ personne.nomOuRaisonSociale }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <hr>

                <h5>Destinataire</h5>
                <input type="hidden" id="hiddenTypeDestinataire" name="typeDestinataire" value="">
                <input type="hidden" id="hiddenServiceDestinataireId" name="serviceDestinataireId" value="">
                <input type="hidden" id="hiddenPersonneDestinataireId" name="personneExterneDestinataireId" value="">

                <div class="mb-3" id="destinataireLockInfo" style="display:none;">
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-lock-fill"></i>
                        Pour un courrier entrant, le destinataire est votre service : <strong>{{ userService.nom }}</strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="typeDestinataire" class="form-label">Type de destinataire *</label>
                            <select class="form-select" id="typeDestinataire" name="typeDestinataire" required>
                                <option value="">-- Sélectionnez --</option>
                                <option value="SERVICE">Service interne</option>
                                <option value="PERSONNE_EXTERNE">Personne externe</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3" id="serviceDestinataireGroup" style="display:none;">
                            <label for="serviceDestinataireId" class="form-label">Service destinataire *</label>
                            <select class="form-select" id="serviceDestinataireId" name="serviceDestinataireId">
                                <option value="">-- Sélectionnez --</option>
                                {% for service in services %}
                                    <option value="{{ service.id }}">{{ service.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3" id="personneExterneDestinataireGroup" style="display:none;">
                            <label for="personneExterneDestinataireId" class="form-label">Personne externe destinataire *</label>
                            <select class="form-select" id="personneExterneDestinataireId" name="personneExterneDestinataireId">
                                <option value="">-- Sélectionnez --</option>
                                {% for personne in personnesExternes %}
                                    <option value="{{ personne.id }}">{{ personne.nomOuRaisonSociale }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="destinatairesCopieIds" class="form-label">Services en copie</label>
                    <select class="form-select" id="destinatairesCopieIds" name="destinatairesCopieIds[]" multiple>
                        {% for service in services %}
                            <option value="{{ service.id }}">{{ service.nom }}</option>
                        {% endfor %}
                    </select>
                    <small class="form-text text-muted">Maintenez Ctrl pour sélectionner plusieurs services</small>
                </div>

                <hr>

                <div class="mb-3">
                    <label for="objet" class="form-label">Objet *</label>
                    <input type="text" class="form-control" id="objet" name="objet" required maxlength="500">
                </div>

                <div class="mb-3">
                    <label for="contenu" class="form-label">Contenu</label>
                    <textarea class="form-control" id="contenu" name="contenu" rows="5"></textarea>
                </div>

                <div class="mb-3">
                    <label for="notes" class="form-label">Notes</label>
                    <textarea class="form-control" id="notes" name="notes" rows="3"></textarea>
                </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-info-circle"></i>
                        Informations
                    </h6>
                    <ul class="list-unstyled small">
                        <li><strong>Courrier Entrant :</strong> Courrier reçu de l'extérieur ou d'un autre service</li>
                        <li><strong>Courrier Sortant :</strong> Courrier envoyé à l'extérieur ou à un autre service</li>
                        <li><strong>Numéro de référence :</strong> Généré automatiquement au format N° XXX – année/DGI/SERVICE</li>
                        <li><strong>Priorités :</strong>
                            <ul class="mb-0">
                                <li>URGENTE : Traitement immédiat requis</li>
                                <li>NORMALE : Traitement standard</li>
                                <li>BASSE : Non urgent</li>
                            </ul>
                        </li>
                    </ul>

                    <h6 class="card-title mt-3">
                        <i class="bi bi-lightbulb"></i>
                        Conseils
                    </h6>
                    <ul class="list-unstyled small">
                        <li>• Vérifiez le type de courrier (Entrant/Sortant)</li>
                        <li>• <strong>Courrier ENTRANT :</strong> Saisissez le numéro de référence de l'expéditeur si disponible. Un numéro d'arrivée sera généré automatiquement : N° XXX-2025/DG/SERVICE</li>
                        <li>• <strong>Courrier SORTANT :</strong> Le numéro de référence sera généré automatiquement au format DGI</li>
                        <li>• Sélectionnez d'abord le type de destinataire</li>
                        <li>• Utilisez "Services en copie" pour informer d'autres services</li>
                        <li>• Rédigez un objet clair et précis</li>
                        <li>• Les pièces jointes peuvent être ajoutées après la création</li>
                        <li>• Une notification sera envoyée automatiquement au destinataire</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Core Elements ---
        const typeSelect = document.getElementById('type');
        const numeroRefField = document.getElementById('numeroReferenceField');
        const typeExpSelect = document.getElementById('typeExpediteur');
        const serviceExpSelect = document.getElementById('serviceExpediteurId');
        const personneExpSelect = document.getElementById('personneExterneExpediteurId');
        const serviceExpGroup = document.getElementById('serviceExpediteurGroup');
        const personneExpGroup = document.getElementById('personneExterneExpediteurGroup');
        const typeDestinataire = document.getElementById('typeDestinataire');
        const serviceDestinataireSelect = document.getElementById('serviceDestinataireId');
        const serviceDestinataireGroup = document.getElementById('serviceDestinataireGroup');
        const personneExterneDestinataireGroup = document.getElementById('personneExterneDestinataireGroup');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const smartDashboard = document.getElementById('smartDashboard');
        const smartOcrSection = document.getElementById('smartOcrSection');
        const smartAiSection = document.getElementById('smartAiSection');
        const userServiceId = "{{ userService.id }}";

        // --- Functions ---
        function toggleSmartDashboard() {
            if (!smartDashboard) return;
            if (typeSelect.value === 'ENTRANT') {
                smartDashboard.style.display = 'block';
                smartOcrSection.style.display = 'block';
                smartAiSection.style.display = 'none';
            } else if (typeSelect.value === 'SORTANT') {
                smartDashboard.style.display = 'block';
                smartOcrSection.style.display = 'none';
                smartAiSection.style.display = 'block';
            } else {
                smartDashboard.style.display = 'none';
            }
        }

        function toggleNumeroReference() {
            if (typeSelect && numeroRefField) {
                numeroRefField.style.display = typeSelect.value === 'ENTRANT' ? 'block' : 'none';
                document.getElementById('numeroReference').required = typeSelect.value === 'ENTRANT';
            }
        }

        function syncExpediteurFields() {
            if (typeExpSelect.value === 'SERVICE') {
                serviceExpGroup.style.display = 'block';
                personneExpGroup.style.display = 'none';
            } else if (typeExpSelect.value === 'PERSONNE_EXTERNE') {
                serviceExpGroup.style.display = 'none';
                personneExpGroup.style.display = 'block';
            } else {
                serviceExpGroup.style.display = 'none';
                personneExpGroup.style.display = 'none';
            }
        }

        function syncDestinataireFields() {
            if (typeDestinataire.value === 'SERVICE') {
                serviceDestinataireGroup.style.display = 'block';
                personneExterneDestinataireGroup.style.display = 'none';
            } else if (typeDestinataire.value === 'PERSONNE_EXTERNE') {
                serviceDestinataireGroup.style.display = 'none';
                personneExterneDestinataireGroup.style.display = 'block';
            } else {
                serviceDestinataireGroup.style.display = 'none';
                personneExterneDestinataireGroup.style.display = 'none';
            }
        }

        function applyExpediteurLock() {
            const isSortant = typeSelect.value === 'SORTANT';
            typeExpSelect.disabled = isSortant;
            serviceExpSelect.disabled = isSortant;
            if (personneExpSelect) personneExpSelect.disabled = isSortant;
            if (isSortant) {
                typeExpSelect.value = 'SERVICE';
                syncExpediteurFields();
                serviceExpSelect.value = userServiceId;
            }
        }

        // --- Smart Logic (OCR, AI, PDF) ---
        const smartOcrFileInput = document.getElementById('smartOcrFileInput');
        document.getElementById('btnSmartOCR')?.addEventListener('click', () => smartOcrFileInput.click());
        smartOcrFileInput?.addEventListener('change', async (e) => {
            if (!e.target.files.length) return;
            const formData = new FormData();
            formData.append('file', e.target.files[0]);
            loadingOverlay.style.display = 'flex';
            try {
                const response = await fetch('http://127.0.0.1:8000/api/extract', { method: 'POST', body: formData });
                if (!response.ok) throw new Error("Erreur lors de l'analyse OCR");
                const result = await response.json();
                const data = result.data || {};
                if (data.subject) document.getElementById('objet').value = data.subject;
                if (data.body) document.getElementById('contenu').value = data.body;
                if (data.letterNumber) document.getElementById('numeroReference').value = data.letterNumber;
                if (data.date) {
                    const dateVal = data.date.match(/\d{4}-\d{2}-\d{2}/);
                    if (dateVal) document.getElementById('dateCourrier').value = dateVal[0];
                }
                alert("Analyse réussie !");
            } catch (error) { alert("Erreur: " + error.message); } 
            finally { loadingOverlay.style.display = 'none'; smartOcrFileInput.value = ''; }
        });

        document.getElementById('btnSmartAI')?.addEventListener('click', async () => {
            const objetField = document.getElementById('objet');
            if (!objetField.value) { alert("Saisissez un objet d'abord."); return; }
            const sSelect = typeExpSelect.value === 'SERVICE' ? serviceExpSelect : personneExpSelect;
            const rSelect = typeDestinataire.value === 'SERVICE' ? serviceDestinataireSelect : document.getElementById('personneExterneDestinataireId');
            const params = {
                senderService: sSelect.options[sSelect.selectedIndex]?.text || "Expéditeur",
                receiverService: rSelect.options[rSelect.selectedIndex]?.text || "Destinataire",
                letterNumber: document.getElementById('numeroReference').value || "N/A",
                importance: document.getElementById('priorite').value || "HAUTE",
                prompt: objetField.value
            };
            loadingOverlay.style.display = 'flex';
            try {
                const response = await fetch('http://127.0.0.1:8000/api/generate-content', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(params) });
                if (!response.ok) throw new Error("Erreur AI");
                const result = await response.json();
                if (result.subject) document.getElementById('objet').value = result.subject;
                if (result.body) document.getElementById('contenu').value = result.body;
                alert("Rédigé !");
            } catch (error) { alert("Erreur: " + error.message); } 
            finally { loadingOverlay.style.display = 'none'; }
        });

        document.getElementById('btnSmartPDF')?.addEventListener('click', async () => {
            const sSelect = typeExpSelect.value === 'SERVICE' ? serviceExpSelect : personneExpSelect;
            const rSelect = typeDestinataire.value === 'SERVICE' ? serviceDestinataireSelect : document.getElementById('personneExterneDestinataireId');
            const mailData = {
                senderService: sSelect.options[sSelect.selectedIndex]?.text || "",
                receiverService: rSelect.options[rSelect.selectedIndex]?.text || "",
                letterNumber: document.getElementById('numeroReference').value || "",
                subject: document.getElementById('objet').value || "",
                importance: document.getElementById('priorite').value || "NORMALE",
                date: document.getElementById('dateCourrier').value || "",
                body: document.getElementById('contenu').value || ""
            };
            loadingOverlay.style.display = 'flex';
            try {
                const response = await fetch('http://127.0.0.1:8000/api/generate-pdf', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(mailData) });
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a'); a.href = url;
                a.download = `courrier_${Date.now()}.pdf`;
                document.body.appendChild(a); a.click(); document.body.removeChild(a);
            } catch (error) { alert("Erreur PDF: " + error.message); } 
            finally { loadingOverlay.style.display = 'none'; }
        });

        // --- URL Parameter Handling (OCR Data) ---
        const urlParams = new URLSearchParams(window.location.search);
        const ocrDataRaw = urlParams.get('ocr_data');
        if (ocrDataRaw) {
            try {
                const ocrData = JSON.parse(decodeURIComponent(ocrDataRaw));
                if (typeSelect) {
                    typeSelect.value = 'ENTRANT';
                    typeSelect.dispatchEvent(new Event('change'));
                }
                if (ocrData.subject) document.getElementById('objet').value = ocrData.subject;
                if (ocrData.body) document.getElementById('contenu').value = ocrData.body;
                if (ocrData.letterNumber) document.getElementById('numeroReference').value = ocrData.letterNumber;
                if (ocrData.date) {
                    const dVal = ocrData.date.match(/\d{4}-\d{2}-\d{2}/);
                    if (dVal) document.getElementById('dateCourrier').value = dVal[0];
                }
                const importanceMap = { 'Normal': 'NORMALE', 'Urgent': 'HAUTE', 'Très Urgent': 'URGENTE' };
                if (ocrData.importance && importanceMap[ocrData.importance]) document.getElementById('priorite').value = importanceMap[ocrData.importance];
                if (ocrData.senderService && typeExpSelect) {
                    typeExpSelect.value = 'SERVICE';
                    typeExpSelect.dispatchEvent(new Event('change'));
                    const sName = ocrData.senderService.toLowerCase();
                    const opts = serviceExpSelect.options;
                    for (let i = 0; i < opts.length; i++) {
                        if (opts[i].text.toLowerCase().includes(sName) || sName.includes(opts[i].text.toLowerCase())) {
                            serviceExpSelect.value = opts[i].value;
                            serviceExpSelect.dispatchEvent(new Event('change'));
                            break;
                        }
                    }
                }
                window.history.replaceState({}, document.title, window.location.pathname);
            } catch (e) { console.error("OCR Data parse error", e); }
        }

        // --- Initial State & Listeners ---
        typeSelect?.addEventListener('change', () => {
            toggleNumeroReference();
            applyExpediteurLock();
            toggleSmartDashboard();
        });
        typeExpSelect?.addEventListener('change', syncExpediteurFields);
        serviceExpSelect?.addEventListener('change', syncExpediteurFields);
        personneExpSelect?.addEventListener('change', syncExpediteurFields);
        typeDestinataire?.addEventListener('change', syncDestinataireFields);
        serviceDestinataireSelect?.addEventListener('change', syncDestinataireFields);
        document.getElementById('personneExterneDestinataireId')?.addEventListener('change', syncDestinataireFields);

        toggleNumeroReference();
        applyExpediteurLock();
        syncExpediteurFields();
        syncDestinataireFields();
        toggleSmartDashboard();
    });
</script>
{% endblock %}
