{% extends 'base.html.twig' %}

{% block title %}Liste des courriers - Gestion de Courrier{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-envelope-paper"></i> {{ pageTitle|default('Gestion des Courriers') }}
            </h1>
        </div>
        <div class="col-auto">
            {% if viewType|default('tous') == 'tous' %}
                {# Exports uniquement dans "Tous les courriers" #}
                <div class="btn-group me-2">
                    <a href="{{ path('courrier_export_excel') }}" class="btn btn-success">
                        <i class="bi bi-file-earmark-excel"></i> Excel
                    </a>
                    <a href="{{ path('courrier_export_pdf') }}" class="btn btn-danger">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </a>
                </div>
            {% endif %}
            {% if not is_granted('ROLE_ADMIN') %}
                {% if viewType|default('tous') == 'sortants' %}
                    <a href="{{ path('courrier_create', {type: 'SORTANT'}) }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Nouveau courrier
                    </a>
                {% elseif viewType|default('tous') == 'entrants' %}
                    <a href="{{ path('courrier_create', {type: 'ENTRANT'}) }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Nouveau courrier
                    </a>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label for="filterExpediteur" class="form-label mb-1">
                        <i class="bi bi-filter"></i> Filtrer par expéditeur
                    </label>
                    <input type="text" id="filterExpediteur" class="form-control" placeholder="Nom ou service expéditeur">
                </div>
                <div class="col-md-4">
                    <label for="filterDestinataire" class="form-label mb-1">
                        <i class="bi bi-filter"></i> Filtrer par destinataire
                    </label>
                    <input type="text" id="filterDestinataire" class="form-control" placeholder="Nom ou service destinataire">
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="courriersTable">
                    <thead>
                        <tr>
                            {% if not is_granted('ROLE_ADMIN') %}
                                <th>Type</th>
                            {% endif %}
                            <th>Objet</th>
                            <th>Expéditeur</th>
                            <th>Destinataire</th>
                            <th>Statut</th>
                            <th>Priorité</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set currentUserService = app.user.service %}
                        {% for courrier in courriers %}
                        <tr>
                            {% if not is_granted('ROLE_ADMIN') %}
                                <td>
                                    {# Utiliser le type relatif au service de l'utilisateur connecté #}
                                    {% set displayedType = (not is_granted('ROLE_ADMIN') and currentUserService)
                                        ? courrier.getTypeRelatif(currentUserService)
                                        : courrier.type %}

                                    {% if displayedType == 'ENTRANT' %}
                                        <span class="badge bg-info">
                                            <i class="bi bi-arrow-down-circle"></i> Entrant
                                        </span>
                                    {% else %}
                                        <span class="badge bg-success">
                                            <i class="bi bi-arrow-up-circle"></i> Sortant
                                        </span>
                                    {% endif %}

                                </td>
                            {% endif %}
                            <td>{{ courrier.objet|length > 50 ? courrier.objet|slice(0, 50) ~ '...' : courrier.objet }}</td>
                            <td>
                                {% if courrier.typeExpediteur == 'SERVICE' %}
                                    <i class="bi bi-building"></i> {{ courrier.serviceExpediteur.nom }}
                                {% else %}
                                    <i class="bi bi-person"></i> {{ courrier.personneExterneExpediteur.nomOuRaisonSociale }}
                                {% endif %}
                            </td>
                            <td>
                                {% if courrier.typeDestinataire == 'SERVICE' %}
                                    <i class="bi bi-building"></i> {{ courrier.serviceDestinataire.nom }}
                                {% else %}
                                    <i class="bi bi-person"></i> {{ courrier.personneExterneDestinataire.nomOuRaisonSociale }}
                                {% endif %}
                            </td>
                            <td>
                                {% set currentUserService = app.user.service %}
                                {% set displayedStatut = (not is_granted('ROLE_ADMIN') and currentUserService)
                                    ? courrier.getStatutRelatif(currentUserService)
                                    : courrier.statut|replace({'_': ' '}) %}

                                {% set statutClass = 'info' %}
                                {% if displayedStatut == 'ACCUSÉ RÉCEPTION REÇU' or courrier.statut in ['CLOS', 'ARCHIVE', 'RECU_CONFIRME', 'ACCUSE_RECEPTION_RECU'] %}
                                    {% set statutClass = 'success' %}
                                {% elseif displayedStatut == 'EN ATTENTE ACCUSÉ RÉCEPTION' %}
                                    {% set statutClass = 'warning' %}
                                {% endif %}

                                <span class="badge bg-{{ statutClass }}">
                                    {{ displayedStatut }}
                                </span>
                            </td>
                            <td>
                                {% set prioriteClass = '' %}
                                {% if courrier.priorite == 'URGENTE' %}
                                    {% set prioriteClass = 'danger' %}
                                {% elseif courrier.priorite == 'HAUTE' %}
                                    {% set prioriteClass = 'warning' %}
                                {% elseif courrier.priorite == 'NORMALE' %}
                                    {% set prioriteClass = 'info' %}
                                {% else %}
                                    {% set prioriteClass = 'secondary' %}
                                {% endif %}
                                <span class="badge bg-{{ prioriteClass }}">
                                    {{ courrier.priorite }}
                                </span>
                            </td>
                            <td>{{ courrier.dateCourrier|date('d/m/Y') }}</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('courrier_show', {id: courrier.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('courrier_edit', {id: courrier.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    {% endif %}
                                    {% if is_granted('ROLE_ADMIN') %}
                                    <form method="post" action="{{ path('courrier_delete', {id: courrier.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce courrier ?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="9" class="text-center text-muted">
                                Aucun courrier trouvé.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Modal OCR #}
<div class="modal fade" id="ocrModal" tabindex="-1" aria-labelledby="ocrModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ocrModalLabel">Importer un courrier via OCR</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Sélectionnez un fichier PDF pour extraire automatiquement les informations du courrier.</p>
                <div class="mb-3">
                    <label for="ocrFile" class="form-label">Fichier PDF</label>
                    <input class="form-control" type="file" id="ocrFile" accept=".pdf">
                </div>
                <div id="ocrStatus" class="mt-3" style="display: none;">
                    <div class="d-flex align-items-center">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                        <span id="ocrStatusText">Analyse en cours...</span>
                    </div>
                </div>
                <div id="ocrError" class="alert alert-danger mt-3" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="startOcrBtn">Démarrer l'extraction</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            const dateColumn = {{ is_granted('ROLE_ADMIN') ? 5 : 6 }};
            const expediteurColumn = {{ is_granted('ROLE_ADMIN') ? 1 : 2 }};
            const destinataireColumn = {{ is_granted('ROLE_ADMIN') ? 2 : 3 }};

            const table = $('#courriersTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json'
                },
                responsive: true,
                pageLength: 25,
                order: [[dateColumn, 'desc']],
                columnDefs: [
                    {
                        targets: -1, // Actions
                        orderable: false,
                        searchable: false
                    }
                ]
            });

            $('#filterExpediteur').on('keyup change', function() {
                table.column(expediteurColumn).search(this.value).draw();
            });

            $('#filterDestinataire').on('keyup change', function() {
                table.column(destinataireColumn).search(this.value).draw();
            });

            // OCR Logic
            const startOcrBtn = document.getElementById('startOcrBtn');
            const ocrFile = document.getElementById('ocrFile');
            const ocrStatus = document.getElementById('ocrStatus');
            const ocrError = document.getElementById('ocrError');
            const ocrStatusText = document.getElementById('ocrStatusText');

            startOcrBtn.addEventListener('click', async () => {
                const file = ocrFile.files[0];
                if (!file) {
                    ocrError.textContent = "Veuillez sélectionner un fichier.";
                    ocrError.style.display = 'block';
                    return;
                }

                ocrError.style.display = 'none';
                ocrStatus.style.display = 'block';
                startOcrBtn.disabled = true;

                const formData = new FormData();
                formData.append('file', file);

                try {
                    const response = await fetch('{{ path('smart_extract') }}', {
                        method: 'POST',
                        body: formData
                    });

                    if (!response.ok) {
                        const errorData = await response.json().catch(() => ({}));
                        throw new Error(errorData.error || "Erreur lors de l'extraction OCR.");
                    }

                    const result = await response.json();
                    if (result.data) {
                        // Redirect to create page with data
                        const ocrData = encodeURIComponent(JSON.stringify(result.data));
                        window.location.href = `{{ path('courrier_create') }}?ocr_data=${ocrData}`;
                    } else {
                        throw new Error("Aucune donnée extraite.");
                    }
                } catch (error) {
                    ocrError.textContent = error.message;
                    ocrError.style.display = 'block';
                    ocrStatus.style.display = 'none';
                    startOcrBtn.disabled = false;
                }
            });
        });
    </script>
{% endblock %}
