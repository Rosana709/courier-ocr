{% extends 'base.html.twig' %}

{% block title %}{{ courrier.numeroReference }} - Gestion de Courrier{% endblock %}

{% block body %}
<!-- Loading Overlay for OCR -->
<div id="loadingOverlay" class="loading-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: white;">
    <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Chargement...</span>
    </div>
    <div class="mt-3 fw-bold fs-5">Validation OCR en cours...</div>
    <div class="small">Vérification de la cohérence du document...</div>
</div>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-envelope"></i> {{ courrier.numeroReference }}
            </h1>
        </div>
        <div class="col-auto">
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('courrier_edit', {id: courrier.id}) }}" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            {% endif %}
            <a href="{{ path('courrier_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Informations générales</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        {% if courrier.numeroArrivee %}
                        <dt class="col-sm-4">Numéro d'arrivée</dt>
                        <dd class="col-sm-8">
                            <strong class="text-primary">{{ courrier.numeroArrivee }}</strong>
                            <span class="badge bg-info ms-2">
                                <i class="bi bi-inbox"></i> Entrant
                            </span>
                        </dd>
                        {% endif %}

                        <dt class="col-sm-4">Numéro de référence</dt>
                        <dd class="col-sm-8">
                            <strong>{{ courrier.numeroReference }}</strong>
                        </dd>

                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">
                            {% set currentUserService = app.user.service %}
                            {% set displayedType = (not is_granted('ROLE_ADMIN') and currentUserService)
                                ? courrier.getTypeRelatif(currentUserService)
                                : courrier.type %}

                            {% if displayedType == 'ENTRANT' %}
                                <span class="badge bg-info">
                                    <i class="bi bi-arrow-down-circle"></i> Entrant
                                </span>
                            {% else %}
                                <span class="badge bg-success">
                                    <i class="bi bi-arrow-up-circle"></i> Sortant
                                </span>
                            {% endif %}
                            {% if courrier.estInterne() %}
                                <span class="badge bg-secondary">Interne</span>
                            {% else %}
                                <span class="badge bg-warning">Externe</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4">Statut</dt>
                        <dd class="col-sm-8">
                            {% set currentUserService = app.user.service %}
                            {% set displayedStatut = (not is_granted('ROLE_ADMIN') and currentUserService)
                                ? courrier.getStatutRelatif(currentUserService)
                                : courrier.statut|replace({'_': ' '}) %}

                            {% set statutClass = 'info' %}
                            {% if displayedStatut == 'ACCUSÉ RÉCEPTION REÇU' or courrier.statut in ['CLOS', 'ARCHIVE', 'RECU_CONFIRME', 'ACCUSE_RECEPTION_RECU'] %}
                                {% set statutClass = 'success' %}
                            {% elseif displayedStatut == 'EN ATTENTE ACCUSÉ RÉCEPTION' %}
                                {% set statutClass = 'warning' %}
                            {% endif %}

                            <span class="badge bg-{{ statutClass }} fs-6">
                                {{ displayedStatut }}
                            </span>
                        </dd>

                        <dt class="col-sm-4">Priorité</dt>
                        <dd class="col-sm-8">
                            {% set prioriteClass = '' %}
                            {% if courrier.priorite == 'URGENTE' %}
                                {% set prioriteClass = 'danger' %}
                            {% elseif courrier.priorite == 'HAUTE' %}
                                {% set prioriteClass = 'warning' %}
                            {% elseif courrier.priorite == 'NORMALE' %}
                                {% set prioriteClass = 'info' %}
                            {% else %}
                                {% set prioriteClass = 'secondary' %}
                            {% endif %}
                            <span class="badge bg-{{ prioriteClass }}">
                                {{ courrier.priorite }}
                            </span>
                        </dd>

                        <dt class="col-sm-4">Date du courrier</dt>
                        <dd class="col-sm-8">{{ courrier.dateCourrier|date('d/m/Y') }}</dd>

                        <dt class="col-sm-4">Date d'enregistrement</dt>
                        <dd class="col-sm-8">{{ courrier.dateEnregistrement|date('d/m/Y H:i') }}</dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Acteurs</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Expéditeur</dt>
                        <dd class="col-sm-8">
                            {% if courrier.typeExpediteur == 'SERVICE' %}
                                <i class="bi bi-building"></i> {{ courrier.serviceExpediteur.nom }}
                                {% if courrier.serviceExpediteur.sigle %}
                                    <span class="badge bg-secondary">{{ courrier.serviceExpediteur.sigle }}</span>
                                {% endif %}
                            {% else %}
                                <i class="bi bi-person"></i> {{ courrier.personneExterneExpediteur.nomOuRaisonSociale }}
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4">Destinataire</dt>
                        <dd class="col-sm-8">
                            {% if courrier.typeDestinataire == 'SERVICE' %}
                                <i class="bi bi-building"></i> {{ courrier.serviceDestinataire.nom }}
                                {% if courrier.serviceDestinataire.sigle %}
                                    <span class="badge bg-secondary">{{ courrier.serviceDestinataire.sigle }}</span>
                                {% endif %}
                            {% else %}
                                <i class="bi bi-person"></i> {{ courrier.personneExterneDestinataire.nomOuRaisonSociale }}
                            {% endif %}
                        </dd>

                    </dl>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Contenu</h5>
                </div>
                <div class="card-body">
                    <h6>Objet</h6>
                    <p>{{ courrier.objet }}</p>

                    {% if courrier.contenu %}
                    <hr>
                    <h6>Contenu</h6>
                    <p class="text-muted">{{ courrier.contenu|nl2br }}</p>
                    {% endif %}

                    {% if courrier.notes %}
                    <hr>
                    <h6>Notes</h6>
                    <p class="text-muted fst-italic">{{ courrier.notes|nl2br }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="card mb-3">
                {% set currentUserService = app.user.service %}
                {% set estExpediteur = currentUserService and courrier.serviceExpediteur and currentUserService.id == courrier.serviceExpediteur.id %}
                {% set estDestinatairePrincipal = currentUserService and courrier.serviceDestinataire and currentUserService.id == courrier.serviceDestinataire.id %}

                {% set isRecipient = estDestinatairePrincipal %}
                {% set isIncomingForRecipient = isRecipient and (courrier.type == 'ENTRANT' or courrier.getTypeRelatif(currentUserService) == 'ENTRANT') %}
                {% set isConfirmed = courrier.statut in ['RECU_CONFIRME', 'ACCUSE_RECEPTION_RECU', 'CLOS', 'ARCHIVE'] %}

                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        {% if isIncomingForRecipient %}
                            <i class="bi bi-file-earmark-check"></i> Digitalisation du courrier
                        {% else %}
                            Document{% if courrier.type != 'SORTANT' %}s joints{% endif %}
                        {% endif %}
                    </h5>
                    {% if is_granted('courrier_edit', courrier) %}
                        {% if not isIncomingForRecipient %}
                            {% if courrier.type == 'SORTANT' %}
                                {% set officialPdf = null %}
                                {% for piece in piecesJointes %}
                                    {% if piece.nomFichierOriginal starts with 'Courrier_Officiel_' %}
                                        {% set officialPdf = piece %}
                                    {% endif %}
                                {% endfor %}
                                
                                {% if not officialPdf %}
                                    <a href="{{ path('courrier_generate_official_pdf', {id: courrier.id}) }}" class="btn btn-sm btn-danger shadow-sm">
                                        <i class="bi bi-file-earmark-pdf"></i> Générer PDF
                                    </a>
                                {% endif %}

                            {% else %}
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
                                    <i class="bi bi-paperclip"></i> Ajouter
                                </button>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </div>
                <div class="card-body">
                    {% if isIncomingForRecipient %}
                        {% if isConfirmed %}
                            <div class="text-center py-4">
                                <i class="bi bi-file-earmark-check text-success display-4"></i>
                                <h6 class="mt-3">Version numérique validée</h6>
                                <p class="text-muted small">Ce courrier a été numérisé et la référence a été vérifiée par OCR.</p>
                                
                                {% set confirmedPiece = null %}
                                {% for piece in piecesJointes %}
                                    {% if piece.nomFichierOriginal starts with 'Courrier_Recu_Confirme_' %}
                                        {% set confirmedPiece = piece %}
                                    {% endif %}
                                {% endfor %}

                                {% if confirmedPiece %}
                                    <div class="mt-3">
                                        <a href="{{ path('piece_jointe_download', {courrierId: courrier.id, id: confirmedPiece.id, inline: 1}) }}" 
                                           class="btn btn-primary" target="_blank">
                                            <i class="bi bi-eye"></i> Voir le courrier numérisé
                                        </a>
                                    </div>
                                {% else %}
                                    <p class="text-danger small">Erreur: Le fichier numérisé est introuvable.</p>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="text-center py-5 border-2 border-dashed rounded bg-light" id="ocrVerificationArea">
                                <i class="bi bi-camera text-primary display-4"></i>
                                <h6 class="mt-3">Vérification de la version numérique</h6>
                                <p class="text-muted px-4">
                                    Pour confirmer la réception physique de ce courrier, veuillez importer sa version numérique scannée. 
                                    Le système vérifiera la cohérence des données par OCR.
                                </p>
                                <input type="file" id="recipientOcrInput" style="display: none;" accept="application/pdf,image/*">
                                <button type="button" class="btn btn-lg btn-primary shadow-sm" id="btnRecipientOCR">
                                    <i class="bi bi-cloud-arrow-up"></i> Importer le document
                                </button>
                                <div class="mt-3 text-info small">
                                    <i class="bi bi-info-circle"></i> La référence du document scanné doit correspondre à : <strong>{{ courrier.numeroReference }}</strong>
                                </div>
                            </div>
                        {% endif %}
                    {% elseif courrier.type == 'SORTANT' %}
                        {# Special view for Outgoing mail: ONLY one PDF (the official one) #}
                        {% set officialPdf = null %}
                        {% for piece in piecesJointes %}
                            {% if piece.nomFichierOriginal starts with 'Courrier_Officiel_' %}
                                {% set officialPdf = piece %}
                            {% endif %}
                        {% endfor %}

                        {% if officialPdf %}
                            <div class="text-center py-4">
                                <div class="mb-3">
                                    <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 4rem;"></i>
                                </div>
                                <h5>Courrier Officiel</h5>
                                <p class="text-muted small mb-4">
                                    Généré le {{ officialPdf.dateTelechargement|date('d/m/Y à H:i') }}
                                </p>
                                
                                <div class="d-grid gap-2 col-mx-auto">
                                    <a href="{{ path('piece_jointe_download', {courrierId: courrier.id, id: officialPdf.id, inline: 1}) }}" 
                                       class="btn btn-outline-primary" target="_blank">
                                        <i class="bi bi-eye"></i> Visualiser le PDF
                                    </a>
                                    <a href="{{ path('piece_jointe_download', {courrierId: courrier.id, id: officialPdf.id}) }}" 
                                       class="btn btn-link btn-sm">
                                        <i class="bi bi-download"></i> Télécharger
                                    </a>
                                </div>

                                {% if courrier.statut in ['ACCUSE_RECEPTION_RECU', 'RECU_CONFIRME', 'CLOS', 'ARCHIVE'] %}
                                    <div class="mt-4 pt-3 border-top">
                                        <span class="badge bg-success py-2 px-3">
                                            <i class="bi bi-check-circle-fill"></i> REÇU PAR LE DESTINATAIRE
                                        </span>
                                        <div class="mt-2 small text-muted">
                                            L'accusé de réception a été envoyé et validé.
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="text-center py-5 border-2 border-dashed rounded bg-light">
                                <i class="bi bi-file-earmark-x text-muted display-4"></i>
                                <h6 class="mt-3">Aucun document</h6>
                                <p class="text-muted small mb-0">Aucun document n'est associé à ce courrier.</p>
                            </div>
                        {% endif %}
                    {% else %}
                        {# Default list view for Incoming mail viewed by sender/admin #}
                        {% if piecesJointes is empty %}
                            <p class="text-muted mb-0">Aucune pièce jointe</p>
                        {% else %}
                            <div class="list-group">
                                {% for piece in piecesJointes %}
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-file-earmark-{{ piece.extension == 'pdf' ? 'pdf' : 'text' }}"></i>
                                        <strong>{{ piece.nomFichierOriginal }}</strong>
                                        <small class="text-muted d-block">
                                            {{ piece.tailleFichierFormate }} -
                                            Ajouté le {{ piece.dateTelechargement|date('d/m/Y à H:i') }}
                                        </small>
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('piece_jointe_download', {courrierId: courrier.id, id: piece.id, inline: 1}) }}"
                                           class="btn btn-outline-success"
                                           target="_blank">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('piece_jointe_download', {courrierId: courrier.id, id: piece.id}) }}"
                                           class="btn btn-outline-primary">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        {% if is_granted('courrier_edit', courrier) %}
                                        <form method="post"
                                              action="{{ path('piece_jointe_delete', {courrierId: courrier.id, id: piece.id}) }}"
                                              onsubmit="return confirm('Supprimer cette pièce jointe ?');"
                                              class="d-inline-block">
                                            <button type="submit" class="btn btn-outline-danger" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                        {% endif %}
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            {% if courrier.typeExpediteur == 'SERVICE'
               and courrier.typeDestinataire == 'SERVICE'
               and (courrier.statut == 'RECU_NON_CONFIRME' or courrier.statut == 'EN_ATTENTE_ACCUSE_RECEPTION') %}
            <div class="card mb-3 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Accusé de réception</h6>
                </div>
                <div class="card-body">
                    {% if courrier.statut == 'RECU_NON_CONFIRME' %}
                        <p class="small">Ce courrier est en attente de confirmation de réception.</p>
                        {% if app.user.service and app.user.service.id == courrier.serviceDestinataire.id %}
                        <form method="post" action="{{ path('courrier_accuse_reception', {id: courrier.id}) }}">
                            <button type="submit" class="btn btn-warning btn-sm w-100">
                                <i class="bi bi-check-circle"></i> Confirmer la réception
                            </button>
                        </form>
                        {% endif %}
                    {% else %}
                        <p class="small">En attente de l'accusé de réception du destinataire.</p>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            <div class="card mb-3">
                <div class="card-header">
                    <h6 class="mb-0">Métadonnées</h6>
                </div>
                <div class="card-body">
                    <p class="small mb-1">
                        <strong>Créé par:</strong><br>
                        {{ courrier.creeParUtilisateur.email }}
                    </p>
                    <p class="small mb-1">
                        <strong>Date de création:</strong><br>
                        {{ courrier.dateCreation|date('d/m/Y H:i') }}
                    </p>
                    {% if courrier.dateModification %}
                    <p class="small mb-0">
                        <strong>Dernière modification:</strong><br>
                        {{ courrier.dateModification|date('d/m/Y H:i') }}
                    </p>
                    {% endif %}
                </div>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
            <div class="card border-secondary">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">Zone Administrateur</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#archiveModal">
                            <i class="bi bi-archive"></i> Archiver
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Modal confirmation archivage -->
<div class="modal fade" id="archiveModal" tabindex="-1" aria-labelledby="archiveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="archiveModalLabel"><i class="bi bi-archive"></i> Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Archiver ce courrier ? Il sera conservé en lecture seule dans la liste des archives.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('courrier_archiver', {id: courrier.id}) }}">
                    <button type="submit" class="btn btn-secondary">
                        <i class="bi bi-archive"></i> Confirmer l'archivage
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal confirmation suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteModalLabel"><i class="bi bi-exclamation-triangle"></i> Confirmation de suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer définitivement ce courrier ?</p>
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i> Cette action est irréversible et supprimera toutes les pièces jointes associées.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('courrier_delete', {id: courrier.id}) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirmer la suppression
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal d'upload de pièce jointe -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('piece_jointe_upload', {courrierId: courrier.id}) }}" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadModalLabel">Ajouter une pièce jointe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="fichier" class="form-label">Fichier *</label>
                        <input type="file" class="form-control" id="fichier" name="fichier" required>
                        <small class="form-text text-muted">
                            Formats acceptés : PDF, JPG, PNG, DOCX, XLSX, DOC, XLS (max 10 Mo)
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload"></i> Téléverser
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('download_pdf')) {
            const btnView = document.getElementById('btnViewOfficialPdf');
            if (btnView) {
                window.location.href = btnView.href;
                const newUrl = window.location.pathname;
                window.history.replaceState({}, '', newUrl);
            }
        }

        // Recipient OCR Validation
        const btnRecipientOCR = document.getElementById('btnRecipientOCR');
        const recipientOcrInput = document.getElementById('recipientOcrInput');
        const loadingOverlay = document.getElementById('loadingOverlay');

        btnRecipientOCR?.addEventListener('click', () => recipientOcrInput.click());

        recipientOcrInput?.addEventListener('change', async (e) => {
            if (!e.target.files.length) return;

            const formData = new FormData();
            formData.append('fichier', e.target.files[0]);
            
            loadingOverlay.style.display = 'flex';

            try {
                const response = await fetch('{{ path('courrier_verify_ocr', {id: courrier.id}) }}', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (err) {
                alert("Une erreur technique est survenue lors de la vérification.");
                console.error(err);
            } finally {
                loadingOverlay.style.display = 'none';
                recipientOcrInput.value = '';
            }
        });
    });
</script>
{% endblock %}
