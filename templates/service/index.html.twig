{% extends 'base.html.twig' %}

{% block title %}Services - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

    <style>
        /* Charte graphique DGI */
        :root {
            --color-primary: #76aaaa;
            --color-primary-light: #91c4c6;
            --color-primary-lighter: #a9d9de;
            --color-primary-dark: #5f8c8c;
        }

        .page-header {
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
            color: white;
            padding: 2rem 0;
            margin: -1.5rem -1.5rem 2rem -1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .btn-light:hover {
            background-color: var(--color-primary-lighter);
            border-color: var(--color-primary-lighter);
        }

        .stats-card {
            border-left: 4px solid;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(118, 170, 170, 0.2);
        }

        .stats-card.active {
            border-left-color: var(--color-primary);
            background: linear-gradient(135deg, #e8f5f5 0%, var(--color-primary-lighter) 100%);
        }

        .stats-card.inactive {
            border-left-color: #d4a5a5;
            background: linear-gradient(135deg, #f9f2f2 0%, #f5e6e6 100%);
        }

        .stats-card.total {
            border-left-color: var(--color-primary-light);
            background: linear-gradient(135deg, #e3f5f5 0%, #c5e8e8 100%);
        }

        .table-card {
            border-radius: 0.5rem;
            box-shadow: 0 2px 8px rgba(118, 170, 170, 0.15);
            border-top: 3px solid var(--color-primary);
        }

        .table-card .card-header {
            background: linear-gradient(90deg, var(--color-primary-lighter) 0%, white 100%);
            border-bottom: 2px solid var(--color-primary-lighter);
        }

        .badge-status {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .bg-primary, .badge.bg-primary {
            background-color: var(--color-primary) !important;
        }

        .text-primary {
            color: var(--color-primary) !important;
        }

        .btn-primary {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
        }

        .btn-primary:hover {
            background-color: var(--color-primary-dark);
            border-color: var(--color-primary-dark);
        }

        .btn-info {
            background-color: var(--color-primary-light);
            border-color: var(--color-primary-light);
        }

        .btn-info:hover {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
        }

        .badge.bg-info {
            background-color: var(--color-primary-lighter) !important;
            color: #333 !important;
        }

        .badge.bg-success {
            background-color: #76aa8e !important;
        }

        table.dataTable tbody tr.inactive-row {
            background-color: #f8f9fa !important;
            opacity: 0.7;
        }

        table.dataTable thead {
            background: #ffffff;
        }

        .action-buttons .btn {
            margin: 0 2px;
        }

        .dataTables_wrapper .dataTables_filter input {
            border-radius: 20px;
            padding: 0.5rem 1rem;
            border: 2px solid var(--color-primary-lighter);
        }

        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 0.2rem rgba(118, 170, 170, 0.25);
        }

        .dataTables_wrapper .dataTables_length select {
            border-radius: 0.25rem;
            border: 1px solid var(--color-primary-lighter);
        }

        .text-capitalize {
            text-transform: capitalize;
        }

        #servicesTable tbody td {
            vertical-align: middle;
        }

        .page-item.active .page-link {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
        }

        .page-link {
            color: var(--color-primary);
        }

        .page-link:hover {
            color: var(--color-primary-dark);
            background-color: var(--color-primary-lighter);
            border-color: var(--color-primary-light);
        }
    </style>
{% endblock %}

{% block body %}
    <div style="margin-top: 2rem;"></div>

    <!-- Header avec gradient -->
    <div class="page-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col">
                    <h1 class="h2 mb-2">
                        <i class="bi bi-building-fill"></i>
                        Gestion des Services
                    </h1>
                    <p class="mb-0 opacity-75">Direction Générale des Impôts - Administration des services internes</p>
                </div>
                <div class="col-auto">
                    <div class="btn-group me-2">
                        <a href="{{ path('service_export_excel') }}" class="btn btn-success btn-lg">
                            <i class="bi bi-file-earmark-excel"></i> Excel
                        </a>
                        <a href="{{ path('service_export_pdf') }}" class="btn btn-danger btn-lg">
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </a>
                    </div>
                    <a href="{{ path('service_create') }}" class="btn btn-light btn-lg">
                        <i class="bi bi-plus-circle-fill"></i> Créer un service
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="row mb-4">
        {% set activeCount = 0 %}
        {% set inactiveCount = 0 %}
        {% for service in services %}
            {% if service.estActif %}
                {% set activeCount = activeCount + 1 %}
            {% else %}
                {% set inactiveCount = inactiveCount + 1 %}
            {% endif %}
        {% endfor %}

        <div class="col-md-4 mb-3">
            <div class="card stats-card total">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total des services</h6>
                            <h2 class="mb-0 fw-bold" style="color: #76aaaa;">{{ services|length }}</h2>
                        </div>
                        <div style="color: #91c4c6;">
                            <i class="bi bi-building" style="font-size: 3rem; opacity: 0.4;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card stats-card active">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Services actifs</h6>
                            <h2 class="mb-0 fw-bold" style="color: #76aa8e;">{{ activeCount }}</h2>
                        </div>
                        <div style="color: #76aa8e;">
                            <i class="bi bi-check-circle-fill" style="font-size: 3rem; opacity: 0.4;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card stats-card inactive">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Services inactifs</h6>
                            <h2 class="mb-0 fw-bold" style="color: #d4a5a5;">{{ inactiveCount }}</h2>
                        </div>
                        <div style="color: #d4a5a5;">
                            <i class="bi bi-x-circle-fill" style="font-size: 3rem; opacity: 0.4;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau des services -->
    <div class="card table-card">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i>
                Liste des services
                <span class="badge bg-primary rounded-pill ms-2">{{ services|length }}</span>
            </h5>
        </div>
        <div class="card-body">
            {% if services|length > 0 %}
                <div class="table-responsive">
                    <table id="servicesTable" class="table table-hover table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="bi bi-hash"></i> ID</th>
                                <th><i class="bi bi-building"></i> Nom du service</th>
                                <th><i class="bi bi-geo-alt"></i> Localité</th>
                                <th><i class="bi bi-envelope"></i> Email</th>
                                <th class="text-center"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for service in services %}
                                <tr class="{% if not service.estActif %}inactive-row{% endif %}">
                                    <td>
                                        <code class="text-primary fw-bold">{{ service.id }}</code>
                                    </td>
                                    <td>
                                        <strong class="text-capitalize">{{ service.nom|lower }}</strong>
                                        {% if not service.estActif %}
                                            <small class="text-muted d-block">
                                                <i class="bi bi-exclamation-triangle"></i> Service désactivé
                                            </small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if service.localite %}
                                            <i class="bi bi-pin-map-fill text-danger"></i> {{ service.localite }}
                                        {% else %}
                                            <span class="text-muted">Non renseignée</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if service.mail %}
                                            <a href="mailto:{{ service.mail }}" class="text-decoration-none">
                                                <i class="bi bi-envelope-fill"></i> {{ service.mail }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">Non renseigné</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm action-buttons" role="group">
                                            <a href="{{ path('service_show', {id: service.id}) }}"
                                               class="btn btn-info"
                                               title="Voir les détails"
                                               data-bs-toggle="tooltip">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a href="{{ path('service_edit', {id: service.id}) }}"
                                               class="btn btn-primary"
                                               title="Modifier"
                                               data-bs-toggle="tooltip">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            {% if service.estActif %}
                                                <button type="button" class="btn btn-warning"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#toggleModal"
                                                        data-service-id="{{ service.id }}"
                                                        data-service-name="{{ service.nom }}"
                                                        data-action="deactivate"
                                                        title="Désactiver">
                                                    <i class="bi bi-pause-circle-fill"></i>
                                                </button>
                                            {% else %}
                                                <button type="button" class="btn btn-success"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#toggleModal"
                                                        data-service-id="{{ service.id }}"
                                                        data-service-name="{{ service.nom }}"
                                                        data-action="activate"
                                                        title="Activer">
                                                    <i class="bi bi-play-circle-fill"></i>
                                                </button>
                                            {% endif %}
                                            <button type="button" class="btn btn-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-service-id="{{ service.id }}"
                                                    data-service-name="{{ service.nom }}"
                                                    title="Supprimer">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>

                                        <!-- Hidden form for deletion -->
                                        <form id="delete-form-{{ service.id }}"
                                              action="{{ path('service_delete', {id: service.id}) }}"
                                              method="post"
                                              style="display: none;">
                                        </form>

                                        <!-- Hidden form for toggle status -->
                                        <form id="toggle-form-{{ service.id }}"
                                              action="{{ path('service_toggle_status', {id: service.id}) }}"
                                              method="post"
                                              style="display: none;">
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-building display-1 text-muted"></i>
                    <h3 class="mt-3">Aucun service trouvé</h3>
                    <p class="text-muted">Commencez par créer un service pour organiser vos courriers.</p>
                    <a href="{{ path('service_create') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Créer le premier service
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Modal de confirmation de suppression -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Confirmation de suppression
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Êtes-vous sûr de vouloir supprimer le service suivant ?</p>
                    <div class="alert alert-light border">
                        <strong id="serviceNameToDelete"></strong>
                    </div>
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Attention :</strong> Cette action est irréversible. Le service sera définitivement supprimé.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>
                        Annuler
                    </button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                        <i class="bi bi-trash me-1"></i>
                        Supprimer définitivement
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de changement de statut -->
    <div class="modal fade" id="toggleModal" tabindex="-1" aria-labelledby="toggleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" id="toggleModalHeader">
                    <h5 class="modal-title" id="toggleModalLabel"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3" id="toggleModalQuestion"></p>
                    <div class="alert alert-light border">
                        <strong id="serviceNameToToggle"></strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>
                        Annuler
                    </button>
                    <button type="button" class="btn" id="confirmToggleBtn"></button>
                </div>
            </div>
        </div>
    </div>

    <!-- DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
    $(document).ready(function() {
        // Initialisation de DataTables
        var table = $('#servicesTable').DataTable({
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json'
            },
            responsive: true,
            pageLength: 25,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Tous"]],
            order: [[1, 'asc']], // Tri par nom par défaut
            dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip',
            columnDefs: [
                {
                    targets: -1, // Colonne Actions (dernière colonne)
                    orderable: false,
                    searchable: false
                }
            ],
            drawCallback: function() {
                // Initialisation des tooltips Bootstrap après chaque dessin du tableau
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.forEach(function(tooltipTriggerEl) {
                    new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }
        });
    });

    // Gestion du modal de suppression
    const deleteModal = document.getElementById('deleteModal');
    let serviceIdToDelete = null;

    deleteModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        serviceIdToDelete = button.getAttribute('data-service-id');
        const serviceName = button.getAttribute('data-service-name');
        document.getElementById('serviceNameToDelete').textContent = serviceName;
    });

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (serviceIdToDelete) {
            document.getElementById('delete-form-' + serviceIdToDelete).submit();
        }
    });

    // Gestion du modal d'activation/désactivation
    const toggleModal = document.getElementById('toggleModal');
    let serviceIdToToggle = null;

    toggleModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        serviceIdToToggle = button.getAttribute('data-service-id');
        const serviceName = button.getAttribute('data-service-name');
        const action = button.getAttribute('data-action');

        document.getElementById('serviceNameToToggle').textContent = serviceName;

        const header = document.getElementById('toggleModalHeader');
        const question = document.getElementById('toggleModalQuestion');
        const confirmBtn = document.getElementById('confirmToggleBtn');

        if (action === 'deactivate') {
            header.className = 'modal-header bg-warning text-dark';
            document.getElementById('toggleModalLabel').innerHTML = '<i class="bi bi-pause-circle-fill me-2"></i>Désactiver le service';
            question.textContent = 'Voulez-vous désactiver ce service ?';
            confirmBtn.className = 'btn btn-warning';
            confirmBtn.innerHTML = '<i class="bi bi-pause-circle me-1"></i>Désactiver';
        } else {
            header.className = 'modal-header bg-success text-white';
            document.getElementById('toggleModalLabel').innerHTML = '<i class="bi bi-play-circle-fill me-2"></i>Activer le service';
            question.textContent = 'Voulez-vous activer ce service ?';
            confirmBtn.className = 'btn btn-success';
            confirmBtn.innerHTML = '<i class="bi bi-play-circle me-1"></i>Activer';
        }
    });

    document.getElementById('confirmToggleBtn').addEventListener('click', function() {
        if (serviceIdToToggle) {
            document.getElementById('toggle-form-' + serviceIdToToggle).submit();
        }
    });
    </script>
{% endblock %}
