{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Administrateur - {{ parent() }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="bi bi-speedometer2"></i>
                Tableau de bord Administrateur
            </h1>
            <p class="text-muted">Vue d'ensemble du système de gestion de courrier</p>
        </div>
    </div>

    {# Statistiques #}
    {# Statistiques #}
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-white h-100" style="background-color: #6a9c96;"> {# Teal color for Services #}
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle mb-2 text-white-50">Services Actifs</h6>
                            <h2 class="card-title mb-0 display-4 fw-bold">{{ stats.services_actifs }}</h2>
                            <small class="text-white-50">Total: {{ stats.total_services }}</small>
                        </div>
                        <div>
                            <i class="bi bi-building" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success h-100" style="background-color: #198754;"> {# Green for Users #}
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle mb-2 text-white-50">Utilisateurs Actifs</h6>
                            <h2 class="card-title mb-0 display-4 fw-bold">{{ stats.utilisateurs_actifs }}</h2>
                            <small class="text-white-50">Total: {{ stats.total_utilisateurs }}</small>
                        </div>
                        <div>
                            <i class="bi bi-people" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info h-100" style="background-color: #0dcaf0;"> {# Cyan/Blue for Mail #}
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle mb-2 text-white-50">Total Courriers</h6>
                            <h2 class="card-title mb-0 display-4 fw-bold">{{ stats.total_couriers }}</h2>
                            <small class="text-white-50">Tous les courriers</small>
                        </div>
                        <div>
                            <i class="bi bi-envelope" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning h-100" style="background-color: #ffc107;"> {# Yellow for Pending #}
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle mb-2 text-white-50">En attente AR</h6>
                            <h2 class="card-title mb-0 display-4 fw-bold">{{ stats.courriers_attente_accuse }}</h2>
                            <small class="text-white-50">Accusés de réception en attente</small>
                        </div>
                        <div>
                            <i class="bi bi-hourglass-split" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        {# Utilisateurs connectés (Moved here to match layout) #}
        <div class="col-md-3">
             <div class="card text-white bg-secondary h-100" style="background-color: #6c757d;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-white-50">Utilisateurs connectés</h6>
                            <h2 class="card-title mb-0 display-4 fw-bold">{{ stats.utilisateurs_connectes }}</h2>
                            <small class="text-white-50">Sessions actives (< 15 min)</small>
                        </div>
                        <div>
                            <i class="bi bi-activity" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Actions rapides #}
    <div class="card mb-4" style="background-color: #6a9c96; border: none;">
        <div class="card-header text-white border-0" style="background-color: transparent;">
             <h5 class="mb-0"><i class="bi bi-lightning-fill"></i> Actions rapides</h5>
        </div>
        <div class="card-body bg-white border border-top-0 rounded-bottom">
            <div class="row g-3">
                <div class="col-md-4">
                    <a href="{{ path('service_create') }}" class="btn btn-outline-secondary w-100 py-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-building fs-4 me-2"></i>
                        <span>Créer un service</span>
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="{{ path('admin_utilisateur_create') }}" class="btn btn-outline-success w-100 py-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-person-plus fs-4 me-2"></i>
                        <span>Créer un utilisateur</span>
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="{{ path('courrier_index') }}" class="btn btn-outline-info w-100 py-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-file-earmark-text fs-4 me-2"></i>
                        <span>Voir tous les courriers</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Journal d'audit #}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Journal d'audit</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-info">10 dernières entrées</span>
                        <a href="{{ path('admin_audit_index') }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-list"></i> Voir tout le journal
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {% if actions_recentres is not defined or actions_recentres|length == 0 %}
                        <div class="text-center py-4">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">Aucune activité enregistrée pour le moment.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">Date & Heure</th>
                                        <th>Entrée d'audit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for action in actions_recentres %}
                                        <tr class="activity-row" data-action-id="{{ action.id }}" style="cursor: pointer;">
                                            <td class="small text-nowrap">{{ action.dateAction|date('d/m/Y H:i') }}</td>
                                            <td>
                                                <span>{{ action.phraseAction }}</span>
                                                
                                                {# Lien vers le courrier si disponible #}
                                                {% if action.courrier %}
                                                    <a href="{{ path('courrier_show', {id: action.courrier.id}) }}" class="ms-2 small text-decoration-none" onclick="event.stopPropagation();">
                                                        <i class="bi bi-link-45deg"></i> Consulter
                                                    </a>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Utilisateurs connectés #}
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Utilisateurs connectés (15 dernières minutes)</h5>
                </div>
                <div class="card-body">
                    {% if sessions_connectees is not defined or sessions_connectees|length == 0 %}
                        <p class="text-muted">Aucun utilisateur connecté actuellement.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Email</th>
                                        <th>Rôle</th>
                                        <th>Dernière activité</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for session in sessions_connectees %}
                                        <tr>
                                            <td>{{ session.utilisateur.email }}</td>
                                            <td>
                                                {% if session.utilisateur.isAdmin() %}
                                                    <span class="badge bg-danger">Admin</span>
                                                {% else %}
                                                    <span class="badge bg-info">Service</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ session.derniereActivite|date('d/m/Y H:i:s') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal pour les détails de l'action #}
<div class="modal fade" id="actionDetailModal" tabindex="-1" aria-labelledby="actionDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="action-detail-content">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
                <p class="mt-2 text-muted">Chargement des détails...</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const activityRows = document.querySelectorAll('.activity-row');
    const modalContent = document.getElementById('action-detail-content');
    const actionModal = new bootstrap.Modal(document.getElementById('actionDetailModal'));

    activityRows.forEach(row => {
        row.addEventListener('click', function(e) {
            // Ne pas ouvrir le modal si on clique sur le lien "Consulter"
            if (e.target.closest('a')) return;

            const actionId = this.dataset.actionId;
            
            // Afficher le loader
            modalContent.innerHTML = `
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="mt-2 text-muted">Chargement des détails...</p>
                </div>
            `;
            
            actionModal.show();

            // Charger les détails via AJAX
            fetch(`/admin/action/${actionId}/detail`)
                .then(response => {
                    if (!response.ok) throw new Error('Erreur réseau');
                    return response.text();
                })
                .then(html => {
                    modalContent.innerHTML = html;
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    modalContent.innerHTML = `
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">Erreur</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Impossible de charger les détails de cette activité.</p>
                        </div>
                    `;
                });
        });
    });
});
</script>
{% endblock %}
