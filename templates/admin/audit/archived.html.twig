{% extends 'base.html.twig' %}

{% block title %}Archives du journal d'audit - Administration{% endblock %}

{% block stylesheets %}
<style>
    .transition-all {
        transition: all 0.3s ease;
    }
    .btn.transition-all:hover {
        filter: brightness(1.1);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('admin_audit_index') }}">Journal d'audit</a></li>
                    <li class="breadcrumb-item active">Archives</li>
                </ol>
            </nav>
            <h1>
                <i class="bi bi-archive-fill"></i>
                Archives du Journal d'Audit
            </h1>
            <p class="text-muted">Historique des actions archivées.</p>
        </div>
        <div class="col-auto d-flex gap-3">
            <a href="{{ path('admin_audit_export_pdf') }}" class="btn btn-danger shadow-sm d-flex align-items-center px-4 py-2 transition-all border-0">
                <i class="bi bi-filetype-pdf me-2 fs-5"></i> 
                <span class="fw-medium">Exporter PDF</span>
            </a>
            <a href="{{ path('admin_audit_index') }}" class="btn btn-primary shadow-sm d-flex align-items-center px-4 py-2 transition-all border-0" style="background-color: #76aaaa;">
                <i class="bi bi-arrow-left-circle me-2 fs-5"></i> 
                <span class="fw-medium">Retour au journal actif</span>
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-body p-0">
            {% if actions|length == 0 %}
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                    <h3 class="mt-3">Aucune archive</h3>
                    <p class="text-muted">Il n'y a pas d'entrées archivées pour le moment.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light text-muted">
                            <tr>
                                <th style="width: 12rem;">Date & Heure</th>
                                <th style="width: 12rem;">Acteur</th>
                                <th>Action</th>
                                <th class="text-end">Infos</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for action in actions %}
                                <tr class="text-muted small">
                                    <td>{{ action.dateAction|date('d/m/Y H:i') }}</td>
                                    <td>
                                        {% if action.effectuePar and action.effectuePar.service %}
                                            {{ action.effectuePar.service.nom }}
                                        {% elseif action.effectuePar %}
                                            {{ action.effectuePar.email }}
                                        {% else %}
                                            Système
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border-0">
                                            {{ action.typeAction }}
                                        </span>
                                        {{ action.description }}
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm p-0" onclick="window.showActionDetail('{{ action.id }}')">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{# Modal pour les détails de l'action #}
<div class="modal fade" id="actionDetailModal" tabindex="-1" aria-labelledby="actionDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="action-detail-content">
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const actionModal = new bootstrap.Modal(document.getElementById('actionDetailModal'));
    const modalContent = document.getElementById('action-detail-content');

    window.showActionDetail = function(actionId) {
        modalContent.innerHTML = `
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            </div>
        `;
        actionModal.show();
        fetch(`/admin/action/${actionId}/detail`).then(r => r.text()).then(h => modalContent.innerHTML = h);
    };
});
</script>
{% endblock %}
