{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublie - {{ parent() }}{% endblock %}

{% block body %}
<style>
    :root {
        --primary: #1b6d82;
        --primary-soft: #3d8da3;
        --bg: #f4f7f9;
        --text: #0f2730;
        --muted: #4a6570;
    }

    body {
        background: radial-gradient(circle at 20% 20%, rgba(27, 109, 130, 0.12) 0, transparent 25%),
                    radial-gradient(circle at 80% 0%, rgba(61, 141, 163, 0.12) 0, transparent 22%),
                    linear-gradient(135deg, #f7fbfd 0%, #ecf3f6 100%);
    }

    .forgot-shell {
        min-height: 80vh;
        display: grid;
        place-items: center;
        padding: 32px 16px;
    }

    .forgot-card {
        width: min(980px, 100%);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.12);
        border: 1px solid rgba(27, 109, 130, 0.12);
    }

    .info-pane {
        background: linear-gradient(135deg, #1b6d82 0%, #3d8da3 100%);
        color: #e9f6fb;
        padding: 32px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: relative;
    }

    .info-pane::after {
        content: "";
        position: absolute;
        inset: 16px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 14px;
        pointer-events: none;
    }

    .info-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.18);
        display: grid;
        place-items: center;
        font-size: 26px;
    }

    .form-pane {
        padding: 32px;
        background: #fff;
    }

    .form-pane h3 {
        color: var(--text);
        font-weight: 800;
        margin-bottom: 8px;
    }

    .form-pane p {
        color: var(--muted);
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #dfe7eb;
        background: #f8fbfc;
        color: var(--text);
    }

    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 0.2rem rgba(27, 109, 130, 0.18);
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-soft) 100%);
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 700;
        letter-spacing: 0.2px;
        color: #f8fbfc;
    }

    .link-muted {
        color: var(--muted);
    }

    @media (max-width: 900px) {
        .forgot-card {
            grid-template-columns: 1fr;
        }
        .info-pane { order: -1; }
    }
</style>

<div class="forgot-shell">
    <div class="forgot-card">
        <div class="info-pane">
            <div class="info-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h4 class="mb-0">Mot de passe oublie</h4>
            <p class="mb-0">Recevez un mot de passe temporaire par email. Il vous sera demande de le changer des votre prochaine connexion.</p>
            <ul class="list-unstyled mb-0">
                <li class="mb-2"><i class="bi bi-check-circle-fill"></i> Envoi securise via le serveur DGI</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill"></i> Token temporaire unique</li>
                <li class="mb-0"><i class="bi bi-check-circle-fill"></i> Redirection vers la mise a jour du mot de passe</li>
            </ul>
        </div>

        <div class="form-pane">
            <h3>Recevoir un mot de passe temporaire</h3>
            <p>Indiquez votre adresse professionnelle. Nous vous enverrons un mot de passe provisoire a changer immediatement.</p>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" class="mt-2">
                <div class="mb-3">
                    <label for="email" class="form-label">Adresse email</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control"
                           required
                           autocomplete="email"
                           placeholder="prenom.nom@impots.mg">
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-send"></i> Envoyer le mot de passe temporaire
                </button>
            </form>

            <div class="mt-3 text-center">
                <a class="link-muted" href="{{ path('app_login') }}"><i class="bi bi-arrow-left-short"></i> Retour a la connexion</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
