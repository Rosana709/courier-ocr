{% extends 'base.html.twig' %}

{% block title %}Personnes Externes - Gestion de Courrier{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-people"></i> Personnes Externes
            </h1>
        </div>
        <div class="col-auto">
            <div class="btn-group me-2">
                <a href="{{ path('personne_externe_export_excel') }}" class="btn btn-success">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </a>
                <a href="{{ path('personne_externe_export_pdf') }}" class="btn btn-danger">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </a>
            </div>
            <a href="{{ path('personne_externe_create') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nouvelle personne
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nom / Raison sociale</th>
                            <th>Type</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Statut</th>
                            <th>Date de création</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for personne in personnes %}
                        <tr>
                            <td>
                                <a href="{{ path('personne_externe_show', {id: personne.id}) }}">
                                    <strong>{{ personne.nomOuRaisonSociale }}</strong>
                                </a>
                            </td>
                            <td>
                                {% if personne.type == 'CONTRIBUABLE' %}
                                    <span class="badge bg-info">Contribuable</span>
                                {% elseif personne.type == 'ENTREPRISE' %}
                                    <span class="badge bg-success">Entreprise</span>
                                {% elseif personne.type == 'ADMINISTRATION' %}
                                    <span class="badge bg-primary">Administration</span>
                                {% else %}
                                    <span class="badge bg-secondary">Organisme</span>
                                {% endif %}
                            </td>
                            <td>{{ personne.email ?? '-' }}</td>
                            <td>{{ personne.telephone ?? '-' }}</td>
                            <td>
                                {% if personne.estActif() %}
                                    <span class="badge bg-success">Actif</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactif</span>
                                {% endif %}
                            </td>
                            <td>{{ personne.dateCreation|date('d/m/Y') }}</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('personne_externe_show', {id: personne.id}) }}"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Voir">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('personne_externe_edit', {id: personne.id}) }}"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                Aucune personne externe enregistrée.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
