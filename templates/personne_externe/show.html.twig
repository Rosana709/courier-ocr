{% extends 'base.html.twig' %}

{% block title %}{{ personne.nomOuRaisonSociale }} - Gestion de Courrier{% endblock %}

{% block body %}
<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-person"></i> {{ personne.nomOuRaisonSociale }}
            </h1>
        </div>
        <div class="col-auto">
            <a href="{{ path('personne_externe_edit', {id: personne.id}) }}" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            <a href="{{ path('personne_externe_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Informations</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Nom / Raison sociale</dt>
                        <dd class="col-sm-8"><strong>{{ personne.nomOuRaisonSociale }}</strong></dd>

                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">
                            {% if personne.type == 'CONTRIBUABLE' %}
                                <span class="badge bg-info">Contribuable</span>
                            {% elseif personne.type == 'ENTREPRISE' %}
                                <span class="badge bg-success">Entreprise</span>
                            {% elseif personne.type == 'ADMINISTRATION' %}
                                <span class="badge bg-primary">Administration</span>
                            {% else %}
                                <span class="badge bg-secondary">Organisme</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4">Statut</dt>
                        <dd class="col-sm-8">
                            {% if personne.estActif() %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactif</span>
                            {% endif %}
                        </dd>

                        {% if personne.adressePostale %}
                        <dt class="col-sm-4">Adresse postale</dt>
                        <dd class="col-sm-8">{{ personne.adressePostale|nl2br }}</dd>
                        {% endif %}

                        {% if personne.telephone %}
                        <dt class="col-sm-4">Téléphone</dt>
                        <dd class="col-sm-8">{{ personne.telephone }}</dd>
                        {% endif %}

                        {% if personne.email %}
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            <a href="mailto:{{ personne.email }}">{{ personne.email }}</a>
                        </dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h6 class="mb-0">Actions</h6>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ path('personne_externe_toggle_status', {id: personne.id}) }}">
                        {% if personne.estActif() %}
                            <button type="submit" class="btn btn-warning btn-sm w-100 mb-2">
                                <i class="bi bi-x-circle"></i> Désactiver
                            </button>
                        {% else %}
                            <button type="submit" class="btn btn-success btn-sm w-100 mb-2">
                                <i class="bi bi-check-circle"></i> Activer
                            </button>
                        {% endif %}
                    </form>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h6 class="mb-0">Métadonnées</h6>
                </div>
                <div class="card-body">
                    <p class="small mb-1">
                        <strong>Date de création:</strong><br>
                        {{ personne.dateCreation|date('d/m/Y H:i') }}
                    </p>
                    {% if personne.dateModification %}
                    <p class="small mb-0">
                        <strong>Dernière modification:</strong><br>
                        {{ personne.dateModification|date('d/m/Y H:i') }}
                    </p>
                    {% endif %}
                </div>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0">Zone Administrateur</h6>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ path('personne_externe_delete', {id: personne.id}) }}"
                          data-confirm="Êtes-vous sûr de vouloir supprimer cette personne externe ?">
                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
